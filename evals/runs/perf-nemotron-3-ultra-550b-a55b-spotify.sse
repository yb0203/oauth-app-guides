data: {"type":"data-guide","id":"guide","data":{"slug":"spotify","permalink":"/guides/spotify","guide":{"verdict":{"tier":"partner_only","summary":"Spotify Open Access requires an approved partner relationship; individuals cannot apply as of May 15 2025, only organizations via company email. A Client ID must be allow-listed by Spotify Partner Management before use.","effort_hours":{"min":2.0,"max":6.0},"calendar":{"min_days":14.0,"max_days":60.0,"label":"Partner approval wait (estimate)"},"calendar_basis":"estimate","confidence":"high"},"situations":{"questions":[{"id":"who","text":"Who will connect to Spotify through the agent?","options":[{"id":"own_org","label":"My own organization only"},{"id":"outside","label":"Outside users or customers"}]},{"id":"action","text":"What must the agent do?","options":[{"id":"read","label":"Read data (playlists, library, playback state)"},{"id":"write","label":"Write or control (playback, entitlements, partner management)"}]}],"variants":[{"when":{"who":"own_org","action":"read"},"tier":"partner_only","summary":"Even internal use requires an approved partner Client ID and allow-listing; development mode caps at 5 allow-listed users and needs a Premium account.","calendar_label":"Partner approval + allow-list setup (weeks)","notes":["Development mode limited to 5 users (c13).","App owner must have Spotify Premium (c14)."]},{"when":{"who":"own_org","action":"write"},"tier":"partner_only","summary":"Write scopes (soa-manage-entitlements, soa-manage-partner, soa-create-partner-user) are only available to approved Open Access partners.","calendar_label":"Partner approval + allow-list setup (weeks)","notes":["Service scopes require partner registration (c7).","Client ID must be allow-listed by Partner Management (c4)."]},{"when":{"who":"outside","action":"read"},"tier":"partner_only","summary":"Outside users need Extended Quota mode, which only organizations can apply for via company email; individuals are not accepted.","calendar_label":"Org application + review (weeks to months)","notes":["Extended quota only for organizations, company email required (c17).","Unlimited installs after approval (c20)."]},{"when":{"who":"outside","action":"write"},"tier":"partner_only","summary":"Full partner integration: organization must be approved, Client ID allow-listed, and service scopes granted by Spotify Partner Management.","calendar_label":"Org application + review (weeks to months)","notes":["Partner-only eligibility (c1).","Allow-listing required before any use (c4)."]}]},"byo_advice":"Composio does not provide a managed Spotify app; you must register your own Client ID in the Spotify Developer Dashboard, get it allow-listed by Spotify Partner Management, then add the Client ID and Secret to a Composio BYO auth config.","before_you_start":[{"text":"The developer console needs a signed-in account: Page at developer.spotify.com loaded but shows no readable content over plain HTTP (a JavaScript app), so a sign-in prompt could not be observed.","evidence":{"label":"TESTED","source_id":"s6","quote":null,"found_in":null,"note":"Our read-only probe on 2026-10-22 loaded https://developer.spotify.com/dashboard and ended at https://developer.spotify.com/dashboard (console reachable)."}},{"text":"You need a Spotify Premium account (required for development mode apps).","evidence":{"label":"DOCS","source_id":"s3","quote":"The app owner must have a Spotify Premium account for apps in development mode to function.","found_in":"visible","note":null}},{"text":"Open Access features are only for approved partners; you must be accepted by Spotify Partner Management.","evidence":{"label":"DOCS","source_id":"s4","quote":"Spotify Open Access features are available only for approved partners","found_in":"visible","note":null}},{"text":"Applications for extended quota must come from an organization using a company email (individuals not accepted after May 15, 2025).","evidence":{"label":"DOCS","source_id":"s3","quote":"Please note that as of May 15th 2025, Spotify only accepts applications from organizations (not individuals). For more information on this update, read here. Application must be sent through a company email by using this form.","found_in":"visible","note":null}}],"limits":[{"what":"Development mode authenticated users","value":5.0,"unit":"users","scope":"development mode app","evidence":{"label":"DOCS","source_id":"s3","quote":"Up to 5 authenticated Spotify users can use an app that is in development mode","found_in":"visible","note":null}},{"what":"Extended quota installs","value":null,"unit":"unlimited","scope":"extended quota mode app","evidence":{"label":"DOCS","source_id":"s3","quote":"Apps in this category can be installed by an unlimited number of users and the allowlist in development mode no longer applies","found_in":"visible","note":null}},{"what":"Entrypoint URL protocol","value":null,"unit":"https required","scope":"OAuth redirect / entrypoint","evidence":{"label":"DOCS","source_id":"s4","quote":"The Entrypoint URL is required to be served over SSL (https)","found_in":"visible","note":null}},{"what":"JWT signing algorithm","value":null,"unit":"HS256","scope":"service-to-service auth","evidence":{"label":"DOCS","source_id":"s4","quote":"The JWT should be signed using the HS256 (HMAC SHA256) algorithm with the client_secret as the signing key","found_in":"visible","note":null}},{"what":"Partner User ID format","value":null,"unit":"16-128 hex chars","scope":"partner user registration","evidence":{"label":"DOCS","source_id":"s4","quote":"The format of a Partner User ID is a lower case string between 16 and 128 hexadecimal characters in length (inclusive)","found_in":"visible","note":null}},{"what":"App owner account requirement","value":null,"unit":"Spotify Premium","scope":"development mode app","evidence":{"label":"DOCS","source_id":"s3","quote":"The app owner must have a Spotify Premium account for apps in development mode to function.","found_in":"visible","note":null}}],"steps":[{"n":1,"title":"Sign in to Spotify Developer Dashboard","detail":"Open https://developer.spotify.com/dashboard and sign in with your Spotify account (Premium required for development mode).","actor":"human","human_reason":"real_account","irreversible":false,"values":[],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Sign-in wall observation shows dashboard reachable but content requires login; Premium requirement from claim c14."}},{"n":2,"title":"Create a new Client ID (app)","detail":"In the dashboard, create a new app/Client ID. Provide a descriptive name and description (used in account linking).","actor":"human","human_reason":"submit","irreversible":true,"values":[{"label":"App name","value":"<your-app-name>"},{"label":"Description","value":"<descriptive text for account linking>"}],"evidence":{"label":"DOCS","source_id":"s4","quote":"Client IDs should be created and managed by the partners themselves through the dashboard","found_in":"visible","note":null}},{"n":3,"title":"Record Client ID and Client Secret","detail":"After creation, copy the Client ID and Client Secret shown in the dashboard.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Client ID","value":"<copy-from-dashboard>"},{"label":"Client Secret","value":"<copy-from-dashboard>"}],"evidence":{"label":"DOCS","source_id":"s4","quote":"Creating a Client ID also generates a Client Secret","found_in":"visible","note":null}},{"n":4,"title":"Set Redirect URI to Composio callback","detail":"In the app settings, add the redirect URI https://backend.composio.dev/api/v3/toolkits/auth/callback (must be HTTPS).","actor":"human","human_reason":"submit","irreversible":false,"values":[{"label":"Redirect URI","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s4","quote":"The Entrypoint URL is required to be served over SSL (https)","found_in":"visible","note":null}},{"n":5,"title":"Configure OAuth scopes","detail":"Add the required Spotify Open Access scopes: user-soa-link (authorization code flow) and soa-manage-entitlements, soa-manage-partner, soa-create-partner-user (client credentials flow).","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Scopes","value":"user-soa-link soa-manage-entitlements soa-manage-partner soa-create-partner-user"}],"evidence":{"label":"DOCS","source_id":"s4","quote":"Spotify Open Access API uses four OAuth 2.0 scopes. One user-related scope to be used in the authorization code flow, and three service-related scopes to be used with the client credentials flow","found_in":"visible","note":null}},{"n":6,"title":"Request Partner allow-listing (Open Access)","detail":"Contact Spotify Partner Management with your Client ID to register as an Open Access partner and receive a Partner ID. Use a company email; individuals are not accepted after May 15, 2025.","actor":"human","human_reason":"submit","irreversible":true,"values":[{"label":"Client ID to provide","value":"<your-client-id>"},{"label":"Contact method","value":"Company email via Spotify Partner Management form"}],"evidence":{"label":"DOCS","source_id":"s4","quote":"Contact the Spotify Partner Management team and provide the Client ID. They will register your Client ID as an Open Access partner and return a Partner ID to you","found_in":"visible","note":null}},{"n":7,"title":"Enter credentials into Composio auth config","detail":"In Composio, create a BYO auth config for Spotify and paste the Client ID and Client Secret. Save and test the connection.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Client ID","value":"<your-client-id>"},{"label":"Client Secret","value":"<your-client-secret>"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Standard Composio BYO flow; not covered by claims."}}],"review":{"required":"yes","trigger":"Creating a Client ID and requesting Open Access allow-listing from Spotify Partner Management","submit":["Client ID","Partner ID (issued after allow-listing)","Company email for organization application"],"reviewer":"Spotify Partner Management team","wait_official":null,"wait_community":null,"cost":null,"evidence":[{"label":"DOCS","source_id":"s4","quote":"Spotify Open Access features are available only for approved partners","found_in":"visible","note":null},{"label":"DOCS","source_id":"s4","quote":"The new Client ID must be allow-listed by the Spotify Partner Management team before it can be used with the Spotify Open Access API","found_in":"visible","note":null},{"label":"UNCERTAIN","source_id":"s3","quote":null,"found_in":null,"note":"Downgraded from DOCS: quote not found on the source page. Original quote: \"Please note that as of May 15th 2025, Spotify only accepts applications from organizations (not individuals). Application must be sent through a company email by using this form.\"."}]},"customer_gates":[{"text":"Partner Management must allow-list your Client ID before Open Access APIs work.","evidence":{"label":"DOCS","source_id":"s4","quote":"The new Client ID must be allow-listed by the Spotify Partner Management team before it can be used with the Spotify Open Access API","found_in":"visible","note":null}},{"text":"Development mode apps limited to 5 allow-listed users; each must be added manually in Dashboard > Settings > Users Management.","evidence":{"label":"DOCS","source_id":"s3","quote":"Up to 5 authenticated Spotify users can use an app that is in development mode","found_in":"visible","note":null}}],"gotchas":[{"text":"Redirect URI must be HTTPS; HTTP is rejected.","evidence":{"label":"DOCS","source_id":"s4","quote":"The Entrypoint URL is required to be served over SSL (https)","found_in":"visible","note":null}},{"text":"JWTs for Open Access must be signed with HS256 using the client_secret as key.","evidence":{"label":"DOCS","source_id":"s4","quote":"The JWT should be signed using the HS256 (HMAC SHA256) algorithm with the client_secret as the signing key","found_in":"visible","note":null}},{"text":"Users not on the development allowlist can log in but API calls return 403.","evidence":{"label":"DOCS","source_id":"s3","quote":"Users may be able to log into a development mode app without having been allowlisted by the developer. However, API requests with an access token associated to that user and app will receive a 403 status code error.","found_in":"visible","note":null}},{"text":"Partner User IDs must be lowercase hex strings 16–128 characters.","evidence":{"label":"DOCS","source_id":"s4","quote":"The format of a Partner User ID is a lower case string between 16 and 128 hexadecimal characters in length (inclusive)","found_in":"visible","note":null}}],"blockers":[{"symptom":"API calls return 403 for authenticated users in development mode.","cause":"User not added to the app's allowlist in Dashboard > Settings > Users Management.","fix":"Add the user's name and Spotify email in the Users Management tab (max 5 users).","evidence":{"label":"DOCS","source_id":"s3","quote":"Users may be able to log into a development mode app without having been allowlisted by the developer. However, API requests with an access token associated to that user and app will receive a 403 status code error.","found_in":"visible","note":null}},{"symptom":"Open Access endpoints reject requests after Client ID creation.","cause":"Client ID not yet allow-listed by Spotify Partner Management.","fix":"Submit Client ID to Partner Management via company email and wait for Partner ID confirmation.","evidence":{"label":"DOCS","source_id":"s4","quote":"The new Client ID must be allow-listed by the Spotify Partner Management team before it can be used with the Spotify Open Access API","found_in":"visible","note":null}},{"symptom":"Extended quota application rejected.","cause":"Application submitted from personal email or by an individual after May 15, 2025.","fix":"Resubmit using a company email address on behalf of an organization.","evidence":{"label":"DOCS","source_id":"s3","quote":"Please note that as of May 15th 2025, Spotify only accepts applications from organizations (not individuals). For more information on this update, read here. Application must be sent through a company email by using this form.","found_in":"visible","note":null}}],"prepared":{"scopes":[{"scope":"user-soa-link","why":"User-related scope for authorization code flow (account linking).","review_class":"restricted"},{"scope":"soa-manage-entitlements","why":"Service scope for managing entitlements via client credentials flow.","review_class":"restricted"},{"scope":"soa-manage-partner","why":"Service scope for partner management via client credentials flow.","review_class":"restricted"},{"scope":"soa-create-partner-user","why":"Service scope for creating partner users via client credentials flow.","review_class":"restricted"}],"privacy_policy_outline":["Describe what user data (Spotify account info, listening data) is collected.","Explain how data is used, stored, and shared.","Provide user data deletion request process.","Link to policy in app description and Composio config."],"consent_screen":{"app_name":"<your-app-name>","description":"<descriptive text for account linking>","privacy_policy_url":"<your-privacy-policy-url>","terms_of_service_url":"<your-tos-url>"},"review_text":"Spotify Open Access requires Partner Management allow-listing of your Client ID. Development mode limited to 5 users. Extended quota requires organization + company email. All four scopes are restricted and need partner approval."},"open_questions":["Exact steps to add OAuth scopes in the current Spotify Developer Dashboard UI (claims list scopes but not UI location).","Whether Composio requires any additional configuration for HS256 JWT signing beyond providing client_secret.","Typical timeline for Partner Management allow-listing response.","Whether the redirect URI must be added before or after Partner allow-listing."],"schema_version":"1","slug":"spotify","app_name":"Spotify","guide_type":"generated","last_verified":"2026-10-22","composio":{"toolkit_slug":"spotify","status":"byo","callback_url":"https://backend.composio.dev/api/v3/toolkits/auth/callback","callback_note":"Copy the exact redirect URI shown in your Composio auth config; some toolkits still show the legacy https://backend.composio.dev/api/v1/auth-apps/add."},"wall_probe":{"console_url":"https://developer.spotify.com/dashboard","final_url":"https://developer.spotify.com/dashboard","redirect_chain":["https://developer.spotify.com/dashboard"],"outcome":"console_reachable","wall_host":null,"asks_for":"Page at developer.spotify.com loaded but shows no readable content over plain HTTP (a JavaScript app), so a sign-in prompt could not be observed","bot_check":false,"method":"http","observed_at":"2026-10-22"},"conflicts":[],"sources":[{"id":"s3","url":"https://developer.spotify.com/documentation/web-api/concepts/quota-modes","title":"Quota modes | Spotify for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s4","url":"https://developer.spotify.com/documentation/open-access/concepts","title":"Open Access Concepts | Spotify for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s6","url":"https://developer.spotify.com/dashboard","title":"Developer console sign-in wall probe","accessed":"2026-10-22","kind":"observation"}],"verification_summary":{"total":29,"tested":1,"docs_verified":25,"docs_hidden":0,"community":0,"uncertain":3}}}}

