data: {"type":"data-guide","id":"guide","data":{"slug":"github","permalink":"/guides/github","guide":{"verdict":{"tier":"unknown","summary":"GitHub documents direct OAuth app registration and user authorization, but the claims do not explicitly state whether GitHub performs a provider review before use. Organization owners may separately need to approve the app, and users must approve newly added repository or organization permissions.","effort_hours":{"min":1.0,"max":3.0},"calendar":{"min_days":0.0,"max_days":null,"label":"No official registration or review wait is stated"},"calendar_basis":"estimate","confidence":"low"},"situations":{"questions":[{"id":"connectors","text":"Who will connect to the OAuth app?","options":[{"id":"own_org","label":"Only my organization"},{"id":"public_users","label":"Outside or public users"},{"id":"mixed","label":"Both my organization and outside users"}]},{"id":"actions","text":"What must the agent do with GitHub?","options":[{"id":"read","label":"Read GitHub data"},{"id":"write","label":"Write to GitHub data"},{"id":"send","label":"Send or publish GitHub content"}]}],"variants":[{"when":{"connectors":"own_org","actions":"read"},"tier":"unknown","summary":"Register an OAuth app under a personal account or an organization where you have administrative access, and request the needed read scopes.","calendar_label":"No official wait stated","notes":[]},{"when":{"connectors":"own_org","actions":"write"},"tier":"unknown","summary":"Register an OAuth app and request the required write scopes; organization restrictions may require owner approval.","calendar_label":"No official wait stated","notes":[]},{"when":{"connectors":"public_users","actions":"read"},"tier":"unknown","summary":"Outside users can authorize the OAuth app, but organizations using access restrictions may require approval before non-public resources are accessible.","calendar_label":"No official wait stated","notes":[]},{"when":{"connectors":"public_users","actions":"write"},"tier":"unknown","summary":"Request write scopes and account for user approval of newly added repository or organization permissions and possible organization-owner approval.","calendar_label":"No official wait stated","notes":[]}]},"byo_advice":"Composio's managed GitHub app is sufficient when its authentication, scopes, and connection behavior meet your needs; use your own OAuth app when you need separate credentials, controlled scopes, or organization-specific access. In GitHub Settings, open Developer settings, select OAuth apps, and click New OAuth App or Register a new application. Enter the app name, full website URL, optional description, and Composio's authorization callback URL; then copy the generated client ID and client secret into the Composio auth config. Request read or write scopes as needed, enable Device Flow only in a constrained environment, and abort authorization when the returned state does not match the supplied state.","before_you_start":[{"text":"The developer console needs a signed-in account: Sign-in page at github.com.","evidence":{"label":"TESTED","source_id":"s6","quote":null,"found_in":null,"note":"Our read-only probe on 2026-10-22 loaded https://github.com/settings/applications/new and ended at https://github.com/login?return_to=https%3A%2F%2Fgithub.com%2Fsettings%2Fapplications%2Fnew (login wall)."}},{"text":"The developer can register under a personal account or an organization where they have administrative access.","evidence":{"label":"DOCS","source_id":"s4","quote":"You can create and register an OAuth app under your personal account or under any organization you have administrative access to.","found_in":"visible","note":null}},{"text":"Each user or organization can own up to 100 OAuth apps.","evidence":{"label":"DOCS","source_id":"s4","quote":"A user or organization can own up to 100 OAuth apps.","found_in":"visible","note":null}},{"text":"Confirm that the developer has the credentials and administrative access required for the intended GitHub account or organization.","evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Check the developer’s available GitHub accounts and organization roles."}}],"limits":[{"what":"OAuth apps owned by each user or organization","value":100.0,"unit":"OAuth apps","scope":"Per user or organization","evidence":{"label":"DOCS","source_id":"s4","quote":"A user or organization can own up to 100 OAuth apps.","found_in":"visible","note":null}},{"what":"Authorization callback URLs","value":10.0,"unit":"callback URLs","scope":"Each OAuth app","evidence":{"label":"DOCS","source_id":"s4","quote":"You can enter up to 10 callback URLs.","found_in":"visible","note":null}},{"what":"Device-flow user verification code validity","value":15.0,"unit":"minutes","scope":"OAuth device-flow user verification code","evidence":{"label":"DOCS","source_id":"s3","quote":"The user must enter a valid code within 15 minutes (or 900 seconds). After 15 minutes, you will need to request a new device authorization code","found_in":"visible","note":"The same limit is also stated as 900 seconds."}},{"what":"Temporary OAuth authorization code lifetime","value":10.0,"unit":"minutes","scope":"OAuth authorization code","evidence":{"label":"DOCS","source_id":"s3","quote":"The temporary code will expire after 10 minutes.","found_in":"visible","note":null}},{"what":"Issued tokens and token creation","value":10.0,"unit":"tokens","scope":"Per user/application/scope combination and per hour","evidence":{"label":"DOCS","source_id":"s5","quote":"There is a limit of ten tokens that are issued per user/application/scope combination","found_in":"visible","note":"GitHub also documents a rate limit of ten tokens created per hour."}},{"what":"OAuth access token lifetime","value":8.0,"unit":"hours","scope":"OAuth access token","evidence":{"label":"DOCS","source_id":"s3","quote":"The access token expires after eight hours, and the refresh token expires after six months without use.","found_in":"visible","note":null}},{"what":"Refresh token lifetime","value":6.0,"unit":"months","scope":"OAuth refresh token without use","evidence":{"label":"DOCS","source_id":"s3","quote":"The access token expires after eight hours, and the refresh token expires after six months without use.","found_in":"visible","note":null}},{"what":"Installation access token lifetime","value":1.0,"unit":"hour","scope":"Installation access token","evidence":{"label":"DOCS","source_id":"s2","quote":"Installation access tokens expire after one hour","found_in":"visible","note":"This claim describes a GitHub App installation token rather than the OAuth registration flow."}}],"steps":[{"n":1,"title":"Sign in to GitHub","detail":"Sign in to the developer’s GitHub account and open the profile menu. The new-app URL is https://github.com/settings/applications/new, but it redirects to sign-in when unauthenticated.","actor":"human","human_reason":"credential","irreversible":false,"values":[{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Check the developer’s account sign-in and whether personal-account or organization ownership is intended."}},{"n":2,"title":"Open the OAuth app registration page","detail":"Open Settings, select Developer settings, then OAuth apps. Click New OAuth App; for a first app, the button is labeled Register a new application.","actor":"human","human_reason":"credential","irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s4","quote":"In the upper-right corner of any page on GitHub, click your profile picture, then click Settings.","found_in":"visible","note":null}},{"n":3,"title":"Register your own OAuth app","detail":"Open the registration form and prepare a public application name, full website URL, optional description, and authorization callback URL. Only use information suitable for public display and avoid internal URLs.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s4","quote":"Only use information in your OAuth app that you consider public. Avoid using sensitive data, such as internal URLs, when creating an OAuth app.","found_in":"visible","note":null}},{"n":4,"title":"Set the Composio callback URL","detail":"Enter Composio’s callback as the app’s authorization callback URL. Do not add a wildcard unless it is specifically required and the associated risk has been assessed.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Authorization callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s2","quote":"Enabling wildcard matching can expose your app to security risks","found_in":"visible","note":null}},{"n":5,"title":"Submit the registration","detail":"Submit the OAuth app registration and wait for GitHub to create the application. This registration must represent the developer’s own app rather than relying on a managed-app configuration.","actor":"human","human_reason":"submit","irreversible":true,"values":[],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Check the exact registration button and whether GitHub displays any provider-level review requirement for this OAuth app."}},{"n":6,"title":"Connect the credentials to Composio","detail":"Retrieve the app’s client ID and client secret, then paste them into the GitHub custom OAuth auth configuration in Composio. Keep the secret confidential and test the connection with the intended account.","actor":"human","human_reason":"credential","irreversible":false,"values":[],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Check Composio’s current BYO GitHub auth-config field names and test procedure."}},{"n":7,"title":"Obtain customer and organization approval","detail":"Ask each customer organization to approve the app when its OAuth access restrictions require it. Approval can be necessary before the app can access that organization’s non-public resources.","actor":"human","human_reason":"submit","irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s5","quote":"For organizations with OAuth app access restrictions, you can request that organization owners approve the application for use in that organization.","found_in":"visible","note":null}}],"review":{"required":"conditional","trigger":"An organization with OAuth app access restrictions may require owner approval, and users must approve newly added repository or organization permissions.","submit":["Request approval from the organization owner when required.","Ask users to approve newly added repository or organization permissions."],"reviewer":null,"wait_official":null,"wait_community":null,"cost":null,"evidence":[{"label":"DOCS","source_id":"s5","quote":"For organizations with OAuth app access restrictions, you can request that organization owners approve the application for use in that organization.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s5","quote":"If the organization does not approve the application, then the application will only be able to access the organization's public resources.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s2","quote":"Until the user approves the new permissions, their app installation will only receive the old permissions.","found_in":"visible","note":null}]},"customer_gates":[{"text":"A user must verify their email address before authorizing the app.","evidence":{"label":"DOCS","source_id":"s5","quote":"You must verify your email address before you can authorize an OAuth app.","found_in":"visible","note":null}},{"text":"An organization with OAuth app access restrictions can require owner approval before the app accesses its resources.","evidence":{"label":"DOCS","source_id":"s5","quote":"For organizations with OAuth app access restrictions, you can request that organization owners approve the application for use in that organization.","found_in":"visible","note":null}},{"text":"Members of SAML-enabled organizations need an active SAML session each time they authorize the app.","evidence":{"label":"DOCS","source_id":"s5","quote":"you must have an active SAML session for each organization each time you authorize an OAuth app.","found_in":"visible","note":null}}],"gotchas":[{"text":"An OAuth app can have up to 10 authorization callback URLs.","evidence":{"label":"DOCS","source_id":"s4","quote":"You can enter up to 10 callback URLs.","found_in":"visible","note":null}},{"text":"Source-code access cannot currently be scoped as read-only.","evidence":{"label":"DOCS","source_id":"s5","quote":"Currently, you can't scope source code access to read-only.","found_in":"visible","note":null}},{"text":"OAuth access tokens can expire after eight hours, while refresh tokens can expire after six months without use.","evidence":{"label":"DOCS","source_id":"s3","quote":"The access token expires after eight hours, and the refresh token expires after six months without use.","found_in":"visible","note":null}},{"text":"Creating more than ten tokens for the same user and scope combination causes GitHub to revoke an existing token with that combination.","evidence":{"label":"DOCS","source_id":"s5","quote":"If an application creates more than ten tokens for the same user and the same scopes, GitHub revokes one of the existing tokens with the same user/application/scope combination","found_in":"visible","note":null}}],"blockers":[{"symptom":"The callback is rejected or authorization does not return to Composio.","cause":"The registered callback URL differs from Composio’s required callback URL.","fix":"Set the authorization callback URL to https://backend.composio.dev/api/v3/toolkits/auth/callback and retest.","evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Verify the exact callback field and whether the same value must also be configured in Composio."}},{"symptom":"The app cannot access a customer organization’s non-public resources.","cause":"The organization has OAuth access restrictions and has not approved the app.","fix":"Request approval from the organization owner, then have the user authorize it again.","evidence":{"label":"DOCS","source_id":"s5","quote":"If the organization does not approve the application, then the application will only be able to access the organization's public resources.","found_in":"visible","note":null}},{"symptom":"An existing user token disappears after additional token creation.","cause":"The same user/application/scope combination exceeded the ten-token limit.","fix":"Avoid unnecessary token creation and have affected users re-authorize as needed.","evidence":{"label":"DOCS","source_id":"s5","quote":"There is a limit of ten tokens that are issued per user/application/scope combination","found_in":"visible","note":null}}],"prepared":{"scopes":[{"scope":"offline_access","why":"Use only if refresh-capable user authorization is needed; it provides an expiring access token and refresh token.","review_class":"unknown"}],"privacy_policy_outline":["Identify the developer and the service connected through Composio.","Describe the GitHub data accessed and why it is needed.","Describe token storage, retention, deletion, and user revocation.","Explain organization approval and permission-change requirements.","Provide a privacy contact and complaint process."],"consent_screen":{"app_name":"Your application name","purpose":"Explain why the app needs GitHub access.","requested_permissions":"List the exact scopes and repository access requested.","data_use":"Describe how GitHub data will be used and shared.","duration_and_revocation":"Explain token lifetime and how users can revoke access.","organization_notice":"Explain that organization owners may require approval."},"review_text":null},"open_questions":["Which exact GitHub scopes and repository permissions does the selected Composio tools require?","Does GitHub apply a provider-level review to this OAuth app, and what is its review text and status?","Should offline_access be enabled for the intended refresh behavior?","Should user-access-token expiration remain enabled or be disabled?","Is device flow needed, and if so, will the app run in a constrained environment?","What are the current Composio field names and validation behavior for custom GitHub OAuth credentials?","Which customer organizations have OAuth access restrictions or require SAML sessions?"],"schema_version":"1","slug":"github","app_name":"GitHub","guide_type":"generated","last_verified":"2026-10-22","composio":{"toolkit_slug":"github","status":"managed","callback_url":"https://backend.composio.dev/api/v3/toolkits/auth/callback","callback_note":"Copy the exact redirect URI shown in your Composio auth config; some toolkits still show the legacy https://backend.composio.dev/api/v1/auth-apps/add."},"wall_probe":{"console_url":"https://github.com/settings/applications/new","final_url":"https://github.com/login?return_to=https%3A%2F%2Fgithub.com%2Fsettings%2Fapplications%2Fnew","redirect_chain":["https://github.com/settings/applications/new","https://github.com/login?return_to=https%3A%2F%2Fgithub.com%2Fsettings%2Fapplications%2Fnew"],"outcome":"login_wall","wall_host":"github.com","asks_for":"Sign-in page at github.com","bot_check":false,"method":"http","observed_at":"2026-10-22"},"conflicts":[],"sources":[{"id":"s2","url":"https://docs.github.com/en/apps/creating-github-apps/about-creating-github-apps/best-practices-for-creating-a-github-app","title":"Best practices for creating a GitHub App - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s3","url":"https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authorizing-oauth-apps","title":"Authorizing OAuth apps - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s4","url":"https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app","title":"Creating an OAuth app - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s5","url":"https://docs.github.com/en/apps/oauth-apps/using-oauth-apps/authorizing-oauth-apps","title":"Authorizing OAuth apps - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s6","url":"https://github.com/settings/applications/new","title":"Developer console sign-in wall probe","accessed":"2026-10-22","kind":"observation"}],"verification_summary":{"total":32,"tested":1,"docs_verified":26,"docs_hidden":0,"community":0,"uncertain":5}}}}

