data: {"type":"data-guide","id":"guide","data":{"slug":"zoom","permalink":"/guides/zoom","guide":{"verdict":{"tier":"instant","summary":"Zoom supports self-service Marketplace app creation and does not state a provider review, usage cap, or partner restriction in the supplied claims. Internal deployment may require account-side pre-approval, and the in-client installation flow requires a published app.","effort_hours":{"min":1.0,"max":3.0},"calendar":{"min_days":0.0,"max_days":null,"label":"Same-day setup estimated; no official review wait stated"},"calendar_basis":"estimate","confidence":"medium"},"situations":{"questions":[{"id":"connectors","text":"Who will connect the app?","options":[{"id":"own_org","label":"Users in my own Zoom organization"},{"id":"outside_users","label":"Outside users"}]},{"id":"actions","text":"What must the agent do?","options":[{"id":"read","label":"Read data"},{"id":"write_send","label":"Write data or send messages"}]}],"variants":[{"when":{"connectors":"own_org","actions":"read"},"tier":"instant","summary":"Create an internal Marketplace app, configure read scopes, and obtain account-admin pre-approval before end users can enable it.","calendar_label":"Same-day setup; account-side pre-approval may be needed","notes":["An account admin or a user with Marketplace permissions must pre-approve the app."]},{"when":{"connectors":"own_org","actions":"write_send"},"tier":"instant","summary":"Create an internal Marketplace app with write, update, or delete scopes; admin capabilities require an account admin or owner.","calendar_label":"Same-day setup; account-side pre-approval may be needed","notes":["Granular scopes support read, write, update, and delete actions.","The user adding the app must be an account admin or owner to receive admin capabilities."]},{"when":{"connectors":"outside_users","actions":"read"},"tier":"instant","summary":"Create and publish a Marketplace app, add read scopes, and complete the OAuth consent flow for each user.","calendar_label":"Estimate; no official review wait stated","notes":["The in-client installation flow is unavailable while the app is unpublished."]},{"when":{"connectors":"outside_users","actions":"write_send"},"tier":"instant","summary":"Create and publish a Marketplace app, add the required write-related scopes, and complete the OAuth consent flow for each user.","calendar_label":"Estimate; no official review wait stated","notes":["If scopes change, Zoom asks the user to reauthorize the app.","When using an external browser, the OAuth flow must start and finish in the same user session."]}]},"byo_advice":"Composio's managed Zoom app is sufficient when its shared authentication and available actions meet the agent's needs. For BYO, sign in to the Zoom Marketplace, create an app, add the required granular scopes, enable In-client OAuth, add the Home URL to the OAuth allow list, and configure the authorize and onAuthorized capabilities; use the app's client ID and generated secret in the Composio auth config, set Composio's callback as the redirect URI, and confirm the exact credential and callback fields in the Zoom console because those details are not covered by the supplied claims.","before_you_start":[{"text":"Use a Zoom account and a user with permissions to access the Created Apps page.","evidence":{"label":"DOCS","source_id":"s3","quote":"Select the Developers link in the lower left corner to open the Created Apps page. If you don't see the Created Apps page, verify that you have the correct permissions.","found_in":"visible","note":null}},{"text":"Decide whether the app should use granular scopes and which permissions are optional.","evidence":{"label":"DOCS","source_id":"s2","quote":"New apps can also set which scopes are required and which are optional.","found_in":"visible","note":null}},{"text":"Prepare a published Marketplace app because the in-client installation flow is unavailable for unpublished apps.","evidence":{"label":"DOCS","source_id":"s3","quote":"The in-client installation flow isn't available for unpublished apps.","found_in":"visible","note":null}}],"limits":[{"what":"Granular-scope action types","value":4.0,"unit":"actions","scope":"Granular scopes: read, write, update, and delete","evidence":{"label":"DOCS","source_id":"s2","quote":"there are total of 4 actions in granular scopes: read, write, update and delete.","found_in":"visible","note":null}},{"what":"Granular-scope access levels","value":3.0,"unit":"access levels","scope":"Granular scopes: none, admin, and master","evidence":{"label":"DOCS","source_id":"s2","quote":"There are 3 possible values: null value, admin and master.","found_in":"visible","note":null}},{"what":"Zoom users available for the documented single-user test approach","value":1.0,"unit":"user","scope":"Testing method when only one Zoom user is available","evidence":{"label":"DOCS","source_id":"s4","quote":"Use this approach when you have only one Zoom user available.","found_in":"visible","note":null}}],"steps":[{"n":1,"title":"Sign in and open Created Apps","detail":"Sign in to the Zoom developer console, select Developers to open the Created Apps page, and confirm you have the required permissions.","actor":"human","human_reason":"credential","irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s3","quote":"Select the Developers link in the lower left corner to open the Created Apps page. If you don't see the Created Apps page, verify that you have the correct permissions.","found_in":"visible","note":null}},{"n":2,"title":"Register the provider app","detail":"Create a new application in the Zoom Marketplace, then open its Scopes section and add the minimum scopes needed by your AI agent.","actor":"human","human_reason":"real_account","irreversible":false,"values":[{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s2","quote":"Create a new application in the Zoom Marketplace. Under Scopes, click Add Scopes.","found_in":"visible","note":null}},{"n":3,"title":"Configure scopes and OAuth","detail":"Choose granular scopes and mark optional scopes deliberately. Enable In-client OAuth, add the Home URL to the OAuth allow list, and configure the authorize and onAuthorized SDK capabilities.","actor":"either","human_reason":null,"irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s3","quote":"Select Features, and enable In-client OAuth.","found_in":"visible","note":"The same source also documents adding the Home URL to the OAuth allow list and enabling authorize and onAuthorized."}},{"n":4,"title":"Set the Composio callback","detail":"Enter Composio's callback as the application's OAuth redirect URI. Confirm the provider accepts this URL and that the app's Home URL is also allow-listed where required.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"OAuth redirect URI","value":"https://backend.composio.dev/api/v3/toolkit/auth/callback"},{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The supplied claims describe an OAuth redirect URL but do not verify the exact provider field or rule for accepting Composio's callback URL."}},{"n":5,"title":"Collect credentials and publish","detail":"Obtain the app's client ID and client secret from Zoom, then submit the app for publishing or Marketplace review. Accept any provider terms and make the required human submissions.","actor":"human","human_reason":"submit","irreversible":false,"values":[{"label":"Composio OAuth callback URL","value":"https://backend.composio.dev/api/v3/toolkit/auth/callback"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The claims establish that an app must be added or published and that unpublished apps cannot use the in-client installation flow, but do not document where the client secret appears."}},{"n":6,"title":"Obtain approval and configure Composio","detail":"After approval and any required account-admin pre-approval, create a Zoom auth config in Composio and paste the client ID, client secret, and Composio callback URL. Test authorization with the intended Zoom account.","actor":"human","human_reason":"wait","irreversible":false,"values":[{"label":"Composio OAuth callback URL","value":"https://backend.composio.dev/api/v3/toolkit/auth/callback"},{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s2","quote":"an account admin, or user with Marketplace permissions for their Zoom Account, must pre-approve the app.","found_in":"visible","note":null}},{"n":7,"title":"Keep the app installable","detail":"Maintain support for users installing through the Zoom Marketplace or the app's own installation pages, and handle reauthorization when scopes change.","actor":"either","human_reason":null,"irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s3","quote":"Your app must continue to support users who install it through the Zoom Marketplace or your own installation pages.","found_in":"visible","note":"The same source states that changed scopes trigger a consent screen and reauthorization."}}],"review":{"required":"no","trigger":null,"submit":[],"reviewer":null,"wait_official":null,"wait_community":null,"cost":null,"evidence":[{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The supplied claims do not state a provider review queue, reviewer, official wait time, or review cost; confirm any Marketplace publication requirements in the developer console."},{"label":"DOCS","source_id":"s2","quote":"an account admin, or user with Marketplace permissions for their Zoom Account, must pre-approve the app.","found_in":"visible","note":null}]},"customer_gates":[{"text":"An account admin or a user with Marketplace permissions must pre-approve the app before end users can enable it.","evidence":{"label":"DOCS","source_id":"s2","quote":"an account admin, or user with Marketplace permissions for their Zoom Account, must pre-approve the app.","found_in":"visible","note":null}},{"text":"Admin capabilities require the user adding the app to be an account admin or owner.","evidence":{"label":"DOCS","source_id":"s2","quote":"The user adding the app must be an account admin or owner in order to be granted admin capabilities.","found_in":"visible","note":null}},{"text":"Master-level scopes can be granted only to account-level apps by account owners.","evidence":{"label":"DOCS","source_id":"s1","quote":"Master-level scopes can only be granted to an an account-level app by account owners.","found_in":"visible","note":null}},{"text":"Granular scopes require an account administrator or a user with role-based access to view and manage Marketplace applications.","evidence":{"label":"DOCS","source_id":"s2","quote":"Account administrators or users with role-based access permission to view and manage applications in the Zoom Marketplace can use granular scopes.","found_in":"visible","note":null}}],"gotchas":[{"text":"If scopes change, users must reauthorize through Zoom's consent screen.","evidence":{"label":"DOCS","source_id":"s3","quote":"If the app has new or changed scopes, Zoom displays a consent screen and asks the user to reauthorize the app.","found_in":"visible","note":null}},{"text":"For external-browser OAuth, start and finish the flow in the same user session.","evidence":{"label":"DOCS","source_id":"s3","quote":"When you use an external browser, make sure the OAuth flow starts and finishes in the same user session.","found_in":"visible","note":null}},{"text":"Only the plain PKCE code-challenge method is supported.","evidence":{"label":"DOCS","source_id":"s3","quote":"codeChallenge: A PKCE code challenge. Only the plain code challenge method is supported.","found_in":"visible","note":null}},{"text":"If using state, verify that the value returned by onAuthorized matches the original value.","evidence":{"label":"DOCS","source_id":"s4","quote":"If you provide a `state` value when calling `authorize`, verify that the value returned in `onAuthorized` matches the value you originally provided.","found_in":"visible","note":null}},{"text":"For non-interactive in-client authorization, confirm scopes have not changed and authorize as the same Zoom user used for web authorization.","evidence":{"label":"DOCS","source_id":"s5","quote":"please make sure there weren’t any scope changes to the app and you’re authorizing within the client as the same Zoom User that you authorized on web.","found_in":"hidden_section","note":null}},{"text":"Optional permissions may be accepted in full, in part, or not at all.","evidence":{"label":"DOCS","source_id":"s2","quote":"Users can select all, some, or no optional permissions during authorization.","found_in":"visible","note":null}}],"blockers":[{"symptom":"The Created Apps page is unavailable.","cause":"The signed-in user lacks the required permissions.","fix":"Verify the user's permissions and sign in with an account that can access the Created Apps page.","evidence":{"label":"DOCS","source_id":"s3","quote":"Select the Developers link in the lower left corner to open the Created Apps page. If you don't see the Created Apps page, verify that you have the correct permissions.","found_in":"visible","note":null}},{"symptom":"The in-client installation flow cannot be used.","cause":"The app is unpublished.","fix":"Publish the app through the Marketplace flow before relying on in-client installation.","evidence":{"label":"DOCS","source_id":"s3","quote":"The in-client installation flow isn't available for unpublished apps.","found_in":"visible","note":null}},{"symptom":"The app cannot be enabled for end users.","cause":"Required account-admin or Marketplace-permission pre-approval is missing.","fix":"Have an eligible administrator or Marketplace-permission holder pre-approve the app.","evidence":{"label":"DOCS","source_id":"s2","quote":"an account admin, or user with Marketplace permissions for their Zoom Account, must pre-approve the app.","found_in":"visible","note":null}}],"prepared":{"scopes":[{"scope":"Minimum Zoom API scopes required by the intended agent actions","why":"The supplied claims do not identify specific scope names or the agent's required Zoom operations, so select only the granular scopes needed for those operations.","review_class":"unknown"}],"privacy_policy_outline":["State that the AI agent accesses Zoom data only through the permissions granted by the authorizing user.","Explain which Zoom categories are read or changed, how long authorization data is retained, and how users can revoke access.","Provide the developer's contact information and a support or complaint channel."],"consent_screen":{"title":"Authorize your AI agent for Zoom","purpose":"Explain that the agent will use Zoom APIs to perform the specific actions enabled by the granted scopes.","data_use":"List each Zoom category the app can access and whether it is read-only or can modify data.","user_control":"Explain that optional permissions can be withheld and that users may revoke authorization later.","redirect_uri":"https://backend.composio.dev/api/v3/toolkit/auth/callback"},"review_text":"The app is a Zoom Marketplace application using granular scopes. It uses Zoom OAuth for user authorization, exchanges the authorization code and PKCE verifier for a REST API access token, and sends the authorization code through onAuthorized to the application server. It supports Marketplace and own-page installation, and reauthorization is required when scopes change."},"open_questions":["What exact minimum Zoom scope identifiers are required for the agent's intended actions?","What Zoom app type and Marketplace build flow apply to this developer's account?","Does Zoom accept Composio's callback URL in the OAuth redirect URI field, and must it also appear in another allow list?","What review duration, pricing, and external-review requirements apply to the selected app type and scopes?","Where does Zoom expose the client secret, and which secret rotation or token-lifetime rules apply?"],"schema_version":"1","slug":"zoom","app_name":"Zoom","guide_type":"generated","last_verified":"2026-10-22","composio":{"toolkit_slug":"zoom","status":"managed","callback_url":"https://backend.composio.dev/api/v3/toolkits/auth/callback","callback_note":"Copy the exact redirect URI shown in your Composio auth config; some toolkits still show the legacy https://backend.composio.dev/api/v1/auth-apps/add."},"wall_probe":null,"conflicts":[],"sources":[{"id":"s1","url":"https://developers.zoom.us/docs/integrations/oauth-scopes-overview/","title":"Integrations - OAuth scopes - Integrations - Zoom Developer Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s2","url":"https://developers.zoom.us/docs/internal-apps/oauth-scopes-overview/","title":"Internal apps - OAuth scopes - Internal Apps - Zoom Developer Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s3","url":"https://godevelopers.zoom.us/docs/zoom-apps/authentication/","title":"Authentication - Zoom Apps - Zoom Developer Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s4","url":"https://godevelopers.zoom.us/docs/zoom-apps/authentication.md","title":"https://godevelopers.zoom.us/docs/zoom-apps/authentication.md","accessed":"2026-10-22","kind":"official_docs"},{"id":"s5","url":"https://devforum.zoom.us/t/in-client-consent-screen/76502","title":"In-client Consent Screen - Zoom Apps - Zoom Developer Forum","accessed":"2026-10-22","kind":"official_docs"}],"verification_summary":{"total":28,"tested":0,"docs_verified":25,"docs_hidden":1,"community":0,"uncertain":3}}}}

