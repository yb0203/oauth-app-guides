data: {"type":"data-guide","id":"guide","data":{"slug":"spotify","permalink":"/guides/spotify","guide":{"verdict":{"tier":"partner_only","summary":"Spotify apps can start in development mode for up to 5 allowlisted users, but onboarding more than 25 users requires quota extension review. Extended quota is limited to established organizations with at least 250,000 monthly active users, so individual developers cannot scale a BYO app.","effort_hours":{"min":4.0,"max":12.0},"calendar":{"min_days":0.0,"max_days":42.0,"label":"Up to 6 weeks for extended-quota review"},"calendar_basis":"official","confidence":"high"},"situations":{"questions":[{"id":"audience","text":"Who will connect through your own Spotify app?","options":[{"id":"own_org","label":"Users in my own organization"},{"id":"outside_users","label":"Outside or public users"}]},{"id":"agent_action","text":"What must the agent do after connecting?","options":[{"id":"read","label":"Read Spotify data"},{"id":"write_send","label":"Write data or send actions"}]}],"variants":[{"when":{"audience":"own_org","agent_action":"read"},"tier":"verify_to_scale","summary":"A development-mode app can serve up to 5 allowlisted users without an initial quota review. The owner needs Spotify Premium, and every user must be allowlisted.","calendar_label":"Immediate up to 5 users; extension review may take 6 weeks","notes":[]},{"when":{"audience":"own_org","agent_action":"write_send"},"tier":"verify_to_scale","summary":"The same development-mode limits apply to write or send actions. Request quota extension when onboarding more than 25 users.","calendar_label":"Immediate up to 5 users; extension review may take 6 weeks","notes":[]},{"when":{"audience":"outside_users","agent_action":"read"},"tier":"partner_only","summary":"Public or outside-user scale requires quota extension and an organization rather than an individual applicant. Applicants must be established legal entities with at least 250,000 MAUs.","calendar_label":"Up to 6 weeks after an eligible organization submits","notes":[]},{"when":{"audience":"outside_users","agent_action":"write_send"},"tier":"partner_only","summary":"Write or send functionality does not remove the organization, MAU, demo, scope, and review requirements for extended quota.","calendar_label":"Up to 6 weeks after an eligible organization submits","notes":[]}]},"byo_advice":null,"before_you_start":[{"text":"The developer console needs a signed-in account: Page at developer.spotify.com loaded but shows no readable content over plain HTTP (a JavaScript app), so a sign-in prompt could not be observed.","evidence":{"label":"TESTED","source_id":"s6","quote":null,"found_in":null,"note":"Our read-only probe on 2026-10-22 loaded https://developer.spotify.com/dashboard and ended at https://developer.spotify.com/dashboard (console reachable)."}},{"text":"The app owner must have a Spotify Premium account for a development-mode app to function.","evidence":{"label":"DOCS","source_id":"s3","quote":"The app owner must have a Spotify Premium account for apps in development mode to function.","found_in":"visible","note":null}},{"text":"Spotify's authorization code flow is intended for long-running applications that can refresh access tokens between user authorizations.","evidence":{"label":"DOCS","source_id":"s1","quote":"The authorization code flow is suitable for long-running applications (e.g. web\nand mobile apps) that can refresh access tokens between user authorizations.","found_in":"visible","note":null}},{"text":"For extended quota, Spotify accepts applications only from organizations, not individuals.","evidence":{"label":"DOCS","source_id":"s3","quote":"Spotify only accepts applications from organizations (not individuals).","found_in":"visible","note":null}},{"text":"The extended-quota applicant must be an established, legally registered business or organization.","evidence":{"label":"DOCS","source_id":"s3","quote":"Established Business Entity (legally registered business or organisation)","found_in":"visible","note":null}},{"text":"The dashboard is reachable at https://developer.spotify.com/dashboard, but its sign-in prompt was not readable in the provided observation.","evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Verify the current dashboard sign-in and app-creation screens in a browser."}}],"limits":[{"what":"Authenticated users allowed to use a development-mode app","value":5.0,"unit":"authenticated Spotify users","scope":"development-mode apps","evidence":{"label":"DOCS","source_id":"s3","quote":"Up to 5 authenticated Spotify users can use an app that is in development mode","found_in":"visible","note":null}},{"what":"Users that may be onboarded before a quota extension request","value":25.0,"unit":"users","scope":"users onboarded by a development-mode app","evidence":{"label":"DOCS","source_id":"s5","quote":"If you wish to onboard more than 25 users you will need to submit a quota extension request.","found_in":"visible","note":null}},{"what":"Minimum active-user scale for a quota-extension applicant","value":250000.0,"unit":"monthly active users","scope":"extended-quota applicants","evidence":{"label":"DOCS","source_id":"s3","quote":"Maintaining a minimum of active users (at least 250k MAUs)","found_in":"visible","note":null}},{"what":"Maximum stated extended-quota review duration","value":6.0,"unit":"weeks","scope":"extended-quota app review","evidence":{"label":"DOCS","source_id":"s3","quote":"This review process can take up to six weeks.","found_in":"visible","note":null}},{"what":"HTTP status for requests by a user not allowlisted","value":403.0,"unit":"HTTP status code","scope":"development-mode app requests by non-allowlisted users","evidence":{"label":"DOCS","source_id":"s3","quote":"API requests with an access token associated to that user and app will receive a 403 status code error.","found_in":"visible","note":null}}],"steps":[{"n":1,"title":"Sign in to Spotify Developer Dashboard","detail":"Sign in to the Spotify developer console and open the developer dashboard. The dashboard is reachable, but the provided observation could not verify whether a readable sign-in prompt appears.","actor":"human","human_reason":"credential","irreversible":false,"values":[],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Confirm the current sign-in flow at https://developer.spotify.com/dashboard."}},{"n":2,"title":"Register your own Spotify app","detail":"Create an application in Spotify's developer console following Spotify's app guide. Use your own developer registration rather than relying on a managed Composio app.","actor":"human","human_reason":"submit","irreversible":true,"values":[],"evidence":{"label":"DOCS","source_id":"s1","quote":"You have created an app following the apps guide.","found_in":"visible","note":null}},{"n":3,"title":"Configure redirect URI and scopes","detail":"Add Spotify's redirect URI to the application's Redirect URI allowlist. Enter it exactly as shown, and request only the scopes needed for the agent; if no scopes are needed, authorization grants access only to publicly available Spotify information.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Redirect URI","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s1","quote":"The value of redirect_uri here must exactly match one of the values you entered when you registered your application, including upper or lowercase, terminating slashes, and such.","found_in":"visible","note":null}},{"n":4,"title":"Capture app credentials","detail":"Copy the Client ID generated for the registered app. Obtain the client secret from the Spotify developer console and keep both credentials for the Composio authentication configuration.","actor":"human","human_reason":"credential","irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s1","quote":"The Client ID generated after registering your application.","found_in":"visible","note":null}},{"n":5,"title":"Configure Spotify in Composio","detail":"Paste your own Spotify Client ID and client secret into Composio's Spotify authentication configuration. Use authorization code flow with response_type set to code and the redirect URI registered above.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Authorization response type","value":"code"},{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s1","quote":"Set to code.","found_in":"visible","note":null}},{"n":6,"title":"Test the OAuth connection","detail":"Exercise the Composio Spotify connection with a test user. Spotify asks the user to authorize the requested scopes, and the token exchange uses POST /api/token with grant_type=authorization_code, the authorization code, and the same redirect_uri.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s1","quote":"It can do this by sending a POST\nrequest to the /api/token endpoint.","found_in":"visible","note":null}},{"n":7,"title":"Request extended quota if needed","detail":"If more than 25 users must onboard, submit a quota extension request through the Developer Dashboard after preparing a working demo. Extended-quota applicants must be established organizations; Spotify reviews and tests the app before granting the mode, and the process can take up to six weeks.","actor":"human","human_reason":"submit","irreversible":true,"values":[],"evidence":{"label":"DOCS","source_id":"s3","quote":"If your Partner Application form is approved, you can ask Spotify to move your app from development mode into extended quota mode.","found_in":"visible","note":null}}],"review":{"required":"conditional","trigger":"Quota extension is required to onboard more than 25 users; it is available only to established organizations with at least 250,000 MAUs.","submit":["Provide app, usage, monetisation, required OAuth scope, and scope-motivation information through the Developer Dashboard.","Provide at least a working app demo.","Pass Spotify's app review and testing for Developer Policy compliance.","After approval, request movement from development mode to extended quota mode."],"reviewer":"Spotify's app review team","wait_official":"The extended-quota app review process can take up to six weeks.","wait_community":null,"cost":null,"evidence":[{"label":"DOCS","source_id":"s3","quote":"Spotify only accepts applications from organizations (not individuals).","found_in":"visible","note":null},{"label":"DOCS","source_id":"s3","quote":"Established Business Entity (legally registered business or organisation)","found_in":"visible","note":null},{"label":"DOCS","source_id":"s3","quote":"Maintaining a minimum of active users (at least 250k MAUs)","found_in":"visible","note":null},{"label":"DOCS","source_id":"s5","quote":"Submitting a quota extension request can be done via the Developer Dashboard, where you will have to provide information about the app, usage, monetisation considerations and required OAuth scopes, along with motivations for the use of the scopes and date.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s5","quote":"Please note that you can't submit a quota extension without having at least a working demo for your app.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s3","quote":"Spotify's app review team will take a look at your app and evaluate it for compliance with our Developer Policy.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s3","quote":"This review process can take up to six weeks.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s3","quote":"If your Partner Application form is approved, you can ask Spotify to move your app from development mode into extended quota mode.","found_in":"visible","note":null}]},"customer_gates":[{"text":"Each Spotify user who installs a development-mode app must be added to the app's allowlist before using it.","evidence":{"label":"DOCS","source_id":"s3","quote":"Each Spotify user who installs your app will need to be added to your app's allowlist before they can use it.","found_in":"visible","note":null}},{"text":"An allowlisted user is enabled by entering the user's name and Spotify email address in the Users Management tab.","evidence":{"label":"DOCS","source_id":"s3","quote":"Tap on the Add new user button and enter the name and Spotify email address of the user that you want to enable to use your app","found_in":"visible","note":null}},{"text":"Spotify presents the requested scopes to the user, who must authorize access to the corresponding data or features.","evidence":{"label":"DOCS","source_id":"s1","quote":"When the user is logged in, they are asked to authorize access to the data sets or features defined in the scopes.","found_in":"visible","note":null}},{"text":"The application must provide users an easily accessible way to disconnect their Spotify account at any time.","evidence":{"label":"DOCS","source_id":"s4","quote":"you must provide all users with an easily accessible mechanism to disconnect their Spotify account from your SDA at any time","found_in":"visible","note":null}},{"text":"Check whether the connecting customer's Spotify or organization administrator restricts app installation, account use, or OAuth permissions; this specific restriction is not stated in the supplied claims.","evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Verify with the customer's Spotify administrator."}}],"gotchas":[{"text":"The redirect URI must exactly match the registered value, including letter case and trailing slashes.","evidence":{"label":"DOCS","source_id":"s1","quote":"The value of redirect_uri here must exactly match one of the values you entered when you registered your application, including upper or lowercase, terminating slashes, and such.","found_in":"visible","note":null}},{"text":"The token request's redirect_uri must exactly match the redirect_uri used in the authorization request.","evidence":{"label":"DOCS","source_id":"s1","quote":"The value of this parameter must exactly match the value of redirect_uri supplied when requesting the authorization code.","found_in":"visible","note":null}},{"text":"The application must compare the returned state with the original state and reject the request if they differ.","evidence":{"label":"DOCS","source_id":"s1","quote":"If there is a mismatch then your app should reject the request and stop the authentication flow.","found_in":"visible","note":null}},{"text":"After Extended Quota Mode approval, OAuth scopes are locked to those requested during Spotify's review; scope changes require a Developer Dashboard request.","evidence":{"label":"DOCS","source_id":"s5","quote":"However, to ensure ongoing quality and safety for our users OAuth scopes will be locked to those requested at time of Spotify review.","found_in":"visible","note":null}},{"text":"The development-mode user limit is up to 5 authenticated Spotify users, while onboarding more than 25 users requires a quota extension request.","evidence":{"label":"DOCS","source_id":"s3","quote":"Up to 5 authenticated Spotify users can use an app that is in development mode","found_in":"visible","note":null}}],"blockers":[{"symptom":"API requests for a user who is not allowlisted return HTTP 403.","cause":"The development-mode app's user allowlist does not include that user.","fix":"Add the user's name and Spotify email address in the Users Management tab, then retry the connection.","evidence":{"label":"DOCS","source_id":"s3","quote":"API requests with an access token associated to that user and app will receive a 403 status code error.","found_in":"visible","note":null}},{"symptom":"A quota extension request cannot be submitted.","cause":"The app does not have at least a working demo.","fix":"Prepare and verify a working app demo before submitting the request.","evidence":{"label":"DOCS","source_id":"s5","quote":"Please note that you can't submit a quota extension without having at least a working demo for your app.","found_in":"visible","note":null}},{"symptom":"The OAuth callback is rejected or the token exchange fails.","cause":"The registered redirect URI differs from the submitted redirect_uri, including casing or trailing-slash differences.","fix":"Register and submit the exact callback value: https://backend.composio.dev/api/v3/toolkits/auth/callback.","evidence":{"label":"DOCS","source_id":"s1","quote":"The value of redirect_uri here must exactly match one of the values you entered when you registered your application, including upper or lowercase, terminating slashes, and such.","found_in":"visible","note":null}}],"prepared":{"scopes":[{"scope":"No scopes; publicly available Spotify information only","why":"This is the minimum authorization when no additional Spotify data or features are required.","review_class":"none"}],"privacy_policy_outline":["Describe the app, the Spotify data accessed, and how the data is used.","Explain that users authorize requested scopes in Spotify's authorization dialog.","Provide an accessible mechanism to disconnect the Spotify account."],"consent_screen":{"authorize_button":"Authorize Spotify access","scope_summary":"List each requested Spotify scope and its purpose.","deny_option":"Allow the user to deny access.","disconnect_option":"Provide an accessible way to disconnect the Spotify account at any time."},"review_text":"Submit the app, usage, monetisation, OAuth scope, and scope-motivation information through the Developer Dashboard; provide a working demo and request extended quota only if more than 25 users must onboard."},"open_questions":["What exact field names does Composio use for the Spotify Client ID and client secret?","Which Spotify scopes does the agent actually need beyond publicly available information?","Does the customer have an established organization and a Spotify Premium account required for the intended mode?","What organization or account-admin restrictions apply to installing the app?"],"schema_version":"1","slug":"spotify","app_name":"Spotify","guide_type":"generated","last_verified":"2026-10-22","composio":{"toolkit_slug":"spotify","status":"byo","callback_url":"https://backend.composio.dev/api/v3/toolkits/auth/callback","callback_note":"Copy the exact redirect URI shown in your Composio auth config; some toolkits still show the legacy https://backend.composio.dev/api/v1/auth-apps/add."},"wall_probe":{"console_url":"https://developer.spotify.com/dashboard","final_url":"https://developer.spotify.com/dashboard","redirect_chain":["https://developer.spotify.com/dashboard"],"outcome":"console_reachable","wall_host":null,"asks_for":"Page at developer.spotify.com loaded but shows no readable content over plain HTTP (a JavaScript app), so a sign-in prompt could not be observed","bot_check":false,"method":"http","observed_at":"2026-10-22"},"conflicts":[],"sources":[{"id":"s1","url":"https://developer.spotify.com/documentation/web-api/tutorials/code-flow","title":"Authorization Code Flow | Spotify for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s3","url":"https://developer.spotify.com/documentation/web-api/concepts/quota-modes","title":"Quota modes | Spotify for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s4","url":"https://developer.spotify.com/policy","title":"Spotify Developer Policy | Spotify for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s5","url":"https://developer.spotify.com/blog/2021-05-27-improving-the-developer-and-user-experience-for-third-party-apps","title":"Improving the developer and user experience for third-party apps | Spotify for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s6","url":"https://developer.spotify.com/dashboard","title":"Developer console sign-in wall probe","accessed":"2026-10-22","kind":"observation"}],"verification_summary":{"total":39,"tested":1,"docs_verified":35,"docs_hidden":0,"community":0,"uncertain":3}}}}

