data: {"type":"data-guide","id":"guide","data":{"slug":"gmail","permalink":"/guides/gmail","guide":{"verdict":{"tier":"review_required","summary":"Register the developer's own Google OAuth app, configure only the required Gmail scopes, and keep it in Testing while developing. External users generally require OAuth verification, including Google review for sensitive scopes; internal-only use may be exempt.","effort_hours":{"min":1.0,"max":4.0},"calendar":{"min_days":14.0,"max_days":28.0,"label":"Several weeks for OAuth verification; sensitive-scope verification typically takes 3-5 business days"},"calendar_basis":"official","confidence":"medium"},"situations":{"questions":[{"id":"who","text":"Who will connect the app?","options":[{"id":"own_org","label":"Users in the developer's own Google Workspace organization"},{"id":"outside","label":"Users outside the developer's organization"}]},{"id":"capability","text":"What must the agent do with Gmail?","options":[{"id":"read","label":"Read Gmail data"},{"id":"write","label":"Modify, send, or otherwise act on Gmail data"}]}],"variants":[{"when":{"who":"own_org","capability":"read"},"tier":"instant","summary":"Create and configure an Internal OAuth app, request only the required scopes, and use the Composio callback URI. Internal applications may not require OAuth verification.","calendar_label":"Immediate after configuration; no official review wait stated","notes":["Configure the OAuth consent screen for Internal user type and keep the project owned by the organization.","Check the selected Gmail scopes' sensitivity category in Google Cloud Console."]},{"when":{"who":"own_org","capability":"write"},"tier":"instant","summary":"Create an Internal OAuth app and request only the write-related Gmail scopes needed. Internal applications may be exempt from OAuth verification, although administrator approval can still apply.","calendar_label":"Immediate after configuration; no official review wait stated","notes":["An internal-use app might require approval from the organization's administrator.","Check the selected Gmail scopes' sensitivity category in Google Cloud Console."]},{"when":{"who":"outside","capability":"read"},"tier":"review_required","summary":"Create an External OAuth app, declare the required scopes, complete the consent-screen setup, and submit it for Google OAuth verification before broad external use.","calendar_label":"Several weeks for OAuth verification; sensitive-scope verification typically takes 3-5 business days","notes":["An unverified-app warning can appear during testing and requires a verification request to remove it.","Only explicitly listed test accounts can authorize an External app while it is in testing."]},{"when":{"who":"outside","capability":"write"},"tier":"review_required","summary":"Create an External OAuth app with the narrowest required Gmail scopes and submit it for verification. Sensitive scopes require Google review, and verification is required before broad external launch.","calendar_label":"Several weeks for OAuth verification; sensitive-scope verification typically takes 3-5 business days","notes":["Provide a publicly accessible demonstration video showing how the app uses the requested scopes.","Google administrators may restrict sensitive scopes and OAuth client IDs that are not trusted."]}]},"byo_advice":"Composio's managed Gmail app is sufficient when its supported scopes and authorization behavior meet the agent's needs. Bring your own OAuth app when you need scopes, branding, user controls, or organization trust that the managed app does not provide, or when Google's verification and administrator requirements affect deployment.","before_you_start":[{"text":"The developer console needs a signed-in account: Sign-in page at accounts.google.com.","evidence":{"label":"TESTED","source_id":"s6","quote":null,"found_in":null,"note":"Our read-only probe on 2026-10-22 loaded https://console.cloud.google.com/auth/overview and ended at https://accounts.google.com/v3/signin/identifier?continue=https://console.cloud.google.com/auth/overview&followup=https://console.cloud.google.com/auth/overview&osid=1&passive=1209600&service=cloudconsole&flowName=GlifWebSignIn&flowEntry=ServiceLogin&dsh=S1730583823:1792650562772441 (login wall)."}},{"text":"Choose Internal only when the project belongs to the Google Workspace organization and the app is limited to that organization's users; otherwise use External.","evidence":{"label":"DOCS","source_id":"s4","quote":"If your Google Cloud project belongs to a Google Workspace organization and only users in your organization use the app, select Internal.","found_in":"visible","note":null}},{"text":"OAuth verification is generally required before an app requesting user credentials is launched to external users.","evidence":{"label":"DOCS","source_id":"s4","quote":"Before launching an application that requests user credentials for the Data Manager API to external users, your Google Cloud project must undergo Google OAuth app verification.","found_in":"visible","note":null}},{"text":"Google OAuth verification may not be required for service-account integrations using Application Default Credentials or certain internal scenarios, but this guide covers the user OAuth path.","evidence":{"label":"DOCS","source_id":"s4","quote":"Google OAuth verification isn't required if your integration uses service accounts with Application Default Credentials (ADC), or in certain other scenarios such as internal applications.","found_in":"visible","note":null}},{"text":"Verification can take several weeks, so submit as early as possible once the consent UI is ready.","evidence":{"label":"DOCS","source_id":"s4","quote":"The Google OAuth app verification process can take several weeks, so submit as early as possible once your UI is ready.","found_in":"visible","note":null}}],"limits":[{"what":"Approved restricted scopes reverified and security assessment completed","value":12.0,"unit":"months","scope":"Apps with approved restricted scopes","evidence":{"label":"DOCS","source_id":"s1","quote":"apps must be reverified for compliance and complete a security assessment at least\nevery 12 months after your assessor's Letter of Assessment (LOA) approval date.","found_in":"visible","note":null}},{"what":"Restricted scopes reverified","value":1.0,"unit":"year","scope":"Apps requesting restricted scopes","evidence":{"label":"DOCS","source_id":"s3","quote":"Apps requesting restricted scopes data need to complete “re-verification” annually.","found_in":"visible","note":null}},{"what":"Unpublished compliant branding verification result validity","value":7.0,"unit":"days","scope":"Unpublished compliant branding verification results","evidence":{"label":"DOCS","source_id":"s2","quote":"Compliant verification results are valid for 7 days.","found_in":"visible","note":null}},{"what":"Test-user restriction","value":null,"unit":"users","scope":"External app in testing","evidence":{"label":"DOCS","source_id":"s4","quote":"Only the listed Google Accounts can authorize the app, and testing limits and token expiration rules apply.","found_in":"visible","note":null}},{"what":"Testing user cap","value":null,"unit":"users","scope":"Unverified app left in testing","evidence":{"label":"DOCS","source_id":"s2","quote":"only available to users you add to the list of test users","found_in":"visible","note":null}},{"what":"Refresh token lifetime","value":null,"unit":"unspecified","scope":"Apps remaining in development or testing","evidence":{"label":"DOCS","source_id":"s2","quote":"the refresh token lifetime is limited.","found_in":"visible","note":null}}],"steps":[{"n":1,"title":"Sign in to Google Cloud Console","detail":"Sign in at https://console.cloud.google.com/auth/overview and open or create the Google Cloud project that will own the OAuth app.","actor":"human","human_reason":"credential","irreversible":false,"values":[{"label":"Google Cloud Console","value":"https://console.cloud.google.com/auth/overview"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":"visible","note":"The supplied observation reached Google's sign-in page; exact console navigation after authentication was not available."}},{"n":2,"title":"Configure the OAuth consent screen","detail":"Choose Internal if only users in the owning Google Workspace organization will use the app; otherwise choose External. Draft the app name, branding, Data Access information, and publishing status.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Publishing status","value":"Testing"},{"label":"Application type","value":"Internal or External, based on the intended users"}],"evidence":{"label":"DOCS","source_id":"s4","quote":"If your Google Cloud project belongs to a Google Workspace organization and only users in your organization use the app, select Internal.","found_in":"visible","note":null}},{"n":3,"title":"Declare the minimum Gmail scopes","detail":"Add every scope the app will request to the Data Access page, but request only the narrowest scopes required by the Gmail functionality.","actor":"agent","human_reason":null,"irreversible":false,"values":[{"label":"Scope selection rule","value":"Request only the scopes your application requires"}],"evidence":{"label":"DOCS","source_id":"s4","quote":"On the Data Access page, request only the scopes your application requires.","found_in":"visible","note":null}},{"n":4,"title":"Register the OAuth redirect URI","detail":"Enter Composio's OAuth callback in the app's authorized redirect URI configuration and register the app for the OAuth flow.","actor":"agent","human_reason":null,"irreversible":false,"values":[{"label":"Authorized redirect URI","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The callback URL is required by the setup instructions, but the supplied claims do not describe Google's redirect URI configuration."}},{"n":5,"title":"Test with designated Google Accounts","detail":"Add test users while the app is in Testing, then verify that the authorization flow works. Testing is subject to test-user and token-expiration restrictions.","actor":"human","human_reason":"real_account","irreversible":false,"values":[{"label":"Publishing status","value":"Testing"}],"evidence":{"label":"DOCS","source_id":"s4","quote":"Only the listed Google Accounts can authorize the app, and testing limits and token expiration rules apply.","found_in":"visible","note":null}},{"n":6,"title":"Prepare and submit verification","detail":"Complete the consent screen, declare every requested scope, and submit the app for Google OAuth verification before making it broadly available to external users. Include a publicly accessible demonstration video showing how the app uses the scopes.","actor":"human","human_reason":"submit","irreversible":false,"values":[{"label":"Publishing status","value":"Testing during initial development"},{"label":"Demonstration video","value":"A publicly accessible link showing how the app uses its requested scopes"}],"evidence":{"label":"DOCS","source_id":"s4","quote":"Provide a link to a publicly accessible demonstration video (such as an unlisted YouTube video or a public Google Drive link) showing how your application uses the requested scopes.","found_in":"visible","note":null}},{"n":7,"title":"Launch and transition the app","detail":"After external-launch review and approval, transition the publishing status from Testing to In production. Restricted-scope apps also require periodic re-verification and a security assessment.","actor":"human","human_reason":"submit","irreversible":true,"values":[{"label":"Publishing status","value":"In production"}],"evidence":{"label":"DOCS","source_id":"s4","quote":"Publishing status: Transition to In production.","found_in":"visible","note":null}}],"review":{"required":"yes","trigger":"External users, broad public availability, or use of sensitive/restricted Gmail scopes may require Google OAuth verification; sensitive scopes require review by Google.","submit":["Set the OAuth consent screen to External for outside users and Internal for organization-only users.","Declare all requested scopes in the Cloud Console and request only the scopes required.","Set publishing status to Testing during development and add required test accounts.","Before launch, transition the app to In production and submit it for OAuth verification.","Provide a publicly accessible demonstration video showing how the app uses the requested scopes."],"reviewer":"Google","wait_official":"The Google OAuth app verification process can take several weeks; sensitive-scope verification typically takes 3-5 business days.","wait_community":null,"cost":null,"evidence":[{"label":"DOCS","source_id":"s4","quote":"Before launching an application that requests user credentials for the Data Manager API to external users, your Google Cloud project must undergo Google OAuth app verification.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s5","quote":"Sensitive scopes require review by Google and have a\nsensitive indicator on the Google Cloud Console's OAuth consent screen configuration\npage.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s4","quote":"The Google OAuth app verification process can take several weeks, so submit as early as possible once your UI is ready.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s2","quote":"The sensitive scope verification process typically takes 3-5 business days to complete.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s4","quote":"Provide a link to a publicly accessible demonstration video (such as an unlisted YouTube video or a public Google Drive link) showing how your application uses the requested scopes.","found_in":"visible","note":null}]},"customer_gates":[{"text":"An internal-use app may require approval from the organization's administrator.","evidence":{"label":"DOCS","source_id":"s1","quote":"In this case, your app might need approval from an organization administrator.","found_in":"visible","note":null}},{"text":"Workspace administrators may restrict sensitive scopes or block OAuth client IDs that the organization has not marked as trusted.","evidence":{"label":"DOCS","source_id":"s2","quote":"organization administrators might restrict access to","found_in":"visible","note":null}},{"text":"Each product defines which application types may request its restricted scopes.","evidence":{"label":"DOCS","source_id":"s1","quote":"Certain application types can access restricted scopes for each product.","found_in":"visible","note":null}}],"gotchas":[{"text":"While an external app is in Testing, only explicitly listed test Google Accounts can authorize it; testing limits and token-expiration rules apply.","evidence":{"label":"DOCS","source_id":"s4","quote":"Only the listed Google Accounts can authorize the app, and testing limits and token expiration rules apply.","found_in":"visible","note":null}},{"text":"Refresh-token lifetime is limited for applications remaining in development or testing.","evidence":{"label":"DOCS","source_id":"s2","quote":"the refresh token lifetime is limited.","found_in":"visible","note":null}},{"text":"Compliant branding verification results expire after seven days if the branding is not published in time.","evidence":{"label":"DOCS","source_id":"s2","quote":"Compliant verification results are valid for 7 days.","found_in":"visible","note":null}},{"text":"Changes to OAuth consent-screen branding are saved as a draft until published.","evidence":{"label":"DOCS","source_id":"s2","quote":"Any changes you make are saved as Draft Branding.","found_in":"visible","note":null}}],"blockers":[{"symptom":"The authorization screen says the app is unverified.","cause":"The app has not completed the required verification request.","fix":"Submit a verification request to remove the unverified-app warning.","evidence":{"label":"DOCS","source_id":"s5","quote":"If you see unverified\napp on the screen when testing your application, you must submit a\nverification request to remove it.","found_in":"visible","note":null}},{"symptom":"External users cannot authorize the app successfully.","cause":"The app may still be limited to listed test users or affected by testing token-expiration rules.","fix":"Complete verification and approval, then transition the app from Testing to In production.","evidence":{"label":"DOCS","source_id":"s4","quote":"Only the listed Google Accounts can authorize the app, and testing limits and token expiration rules apply.","found_in":"visible","note":null}},{"symptom":"The planned Gmail features require a broader scope than expected.","cause":"Google recommends choosing a non-sensitive scope where possible because scopes overlap.","fix":"Narrow each requested scope to the least access required, and have Google Cloud Console classify the selected scopes.","evidence":{"label":"DOCS","source_id":"s5","quote":"Many scopes overlap, so it's best to use a scope that isn't sensitive.","found_in":"visible","note":null}}],"prepared":{"scopes":[],"privacy_policy_outline":["Identify the developer or organization, Gmail data accessed, how data is used and retained, and a support or privacy contact."],"consent_screen":{"Publishing status":"Testing","Application type":"Internal or External based on intended users","Data Access":"Declare every requested scope and request only the access required by the Gmail features","Branding":"Prepare and publish the consent-screen branding before launch"},"review_text":"Submit the completed consent screen with every requested scope declared and a publicly accessible demonstration video showing how the app uses those scopes."},"open_questions":["Which exact Gmail scopes are required for the agent’s intended read, send, draft, modify, and delete operations?","Which selected Gmail scopes are categorized as sensitive or restricted in Google Cloud Console?","Does the deployment require Internal or External app type?","Is the intended deployment limited to users in the owning Google Workspace organization?","What additional sensitive-scope verification or security-assessment materials will Google require?"],"schema_version":"1","slug":"gmail","app_name":"Gmail","guide_type":"generated","last_verified":"2026-10-22","composio":{"toolkit_slug":"gmail","status":"managed","callback_url":"https://backend.composio.dev/api/v3/toolkits/auth/callback","callback_note":"Copy the exact redirect URI shown in your Composio auth config; some toolkits still show the legacy https://backend.composio.dev/api/v1/auth-apps/add."},"wall_probe":{"console_url":"https://console.cloud.google.com/auth/overview","final_url":"https://accounts.google.com/v3/signin/identifier?continue=https://console.cloud.google.com/auth/overview&followup=https://console.cloud.google.com/auth/overview&osid=1&passive=1209600&service=cloudconsole&flowName=GlifWebSignIn&flowEntry=ServiceLogin&dsh=S1730583823:1792650562772441","redirect_chain":["https://console.cloud.google.com/auth/overview","https://accounts.google.com/ServiceLogin?service=cloudconsole&passive=1209600&osid=1&continue=https://console.cloud.google.com/auth/overview&followup=https://console.cloud.google.com/auth/overview","https://accounts.google.com/v3/signin/identifier?continue=https://console.cloud.google.com/auth/overview&followup=https://console.cloud.google.com/auth/overview&osid=1&passive=1209600&service=cloudconsole&flowName=GlifWebSignIn&flowEntry=ServiceLogin&dsh=S1730583823:1792650562772441"],"outcome":"login_wall","wall_host":"accounts.google.com","asks_for":"Sign-in page at accounts.google.com","bot_check":false,"method":"http","observed_at":"2026-10-22"},"conflicts":[],"sources":[{"id":"s1","url":"https://developers.google.com/identity/protocols/oauth2/production-readiness/restricted-scope-verification","title":"Restricted scope verification | App verification to use Google Authorization APIs | Google for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s2","url":"https://developers.google.com/identity/protocols/oauth2/production-readiness/sensitive-scope-verification","title":"Sensitive scope verification | App verification to use Google Authorization APIs | Google for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s3","url":"https://support.google.com/cloud/answer/13463073","title":"OAuth App Verification Help Center - Google Cloud Platform Console Help","accessed":"2026-10-22","kind":"official_docs"},{"id":"s4","url":"https://developers.google.com/data-manager/api/devguides/concepts/oauth-verification","title":"OAuth app verification | Data Manager API | Google for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s5","url":"https://developers.google.com/identity/protocols/oauth2/scopes","title":"OAuth 2.0 Scopes for Google APIs | Google for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s6","url":"https://console.cloud.google.com/auth/overview","title":"Developer console sign-in wall probe","accessed":"2026-10-22","kind":"observation"}],"verification_summary":{"total":33,"tested":1,"docs_verified":30,"docs_hidden":0,"community":0,"uncertain":2}}}}

