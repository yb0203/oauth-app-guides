data: {"type":"data-guide","id":"guide","data":{"slug":"dropbox","permalink":"/guides/dropbox","guide":{"verdict":{"tier":"review_required","summary":"Create your own Dropbox app manually, configure its exact Composio callback URI and least-privilege scopes, then obtain the client credentials for the Composio auth config. Standard Dropbox API use is not described as requiring approval, but Dropbox Sign embedded or OAuth workflows require an approval request.","effort_hours":{"min":1.0,"max":3.0},"calendar":{"min_days":0.0,"max_days":null,"label":"No official wait stated; Dropbox Sign approval timing is unknown"},"calendar_basis":"estimate","confidence":"medium"},"situations":{"questions":[{"id":"connectors","text":"Who will connect the app?","options":[{"id":"own_org","label":"Only my organization"},{"id":"outside_users","label":"Outside or public users"}]},{"id":"actions","text":"What must the agent do?","options":[{"id":"read","label":"Read Dropbox data"},{"id":"write","label":"Write or modify Dropbox data"},{"id":"sign","label":"Send Dropbox Sign requests or embedded signing"}]}],"variants":[{"when":{"connectors":"own_org","actions":"read"},"tier":"instant","summary":"Register one app for the actual application, add the exact Composio callback URI, request read scopes, and paste the resulting client credentials into the Composio auth config.","calendar_label":"Registration can begin immediately; no review is stated for standard Dropbox API read access","notes":["Dropbox supports manually registered apps and scoped access.","The App Console sign-in page is a sign-in wall; no callback or credential values were visible."]},{"when":{"connectors":"outside_users","actions":"write"},"tier":"instant","summary":"Register and configure the app for scoped write access, including the exact Composio callback URI and the minimum permissions required.","calendar_label":"Registration can begin immediately; no standard Dropbox API review is stated","notes":["The selected app scopes determine which API calls the app may execute.","Requesting unnecessary access may hurt app review and cause users to reject authorization."]},{"when":{"connectors":"outside_users","actions":"sign"},"tier":"review_required","summary":"For embedded signing or Dropbox Sign OAuth, review Dropbox's approval documentation and submit the relevant request before leaving test mode.","calendar_label":"Approval wait is not stated","notes":["An unapproved API app is limited to test mode for embedded or OAuth workflows.","Non-embedded signing does not require an approval request but requires a paid Dropbox Sign API Essentials plan or higher."]}]},"byo_advice":"Composio's managed Dropbox app may be sufficient for standard Dropbox API connections when its supported scopes fit. Register your own app when you need your own client credentials, controlled scopes, a specific Composio callback configuration, or Dropbox Sign workflows; even with a managed option, your own registration remains the client registration used by that app.","before_you_start":[{"text":"The developer console needs a signed-in account: Sign-in page at www.dropbox.com.","evidence":{"label":"TESTED","source_id":"s6","quote":null,"found_in":null,"note":"Our read-only probe on 2026-10-22 loaded https://www.dropbox.com/developers/apps and ended at https://www.dropbox.com/login?cont=https%3A%2F%2Fwww.dropbox.com%2Fdevelopers%2Fapps (login wall)."}},{"text":"Create one app registration for each actual application you build.","evidence":{"label":"COMMUNITY","source_id":"s4","quote":"You should create one app registration per actual app that you are building.","found_in":"hidden_section","note":null}},{"text":"Dropbox does not support programmatic app registration.","evidence":{"label":"COMMUNITY","source_id":"s4","quote":"Dropbox also does not support registering apps programmatically. You should only be registering apps manually.","found_in":"hidden_section","note":null}},{"text":"Use Dropbox's OAuth code flow for the application.","evidence":{"label":"DOCS","source_id":"s1","quote":"The code flow is the recommended OAuth flow for all types of applications.","found_in":"visible","note":null}},{"text":"Decide whether the agent needs only online access or also offline or background access.","evidence":{"label":"DOCS","source_id":"s1","quote":"These apps may instead use long-lived refresh tokens can be used to obtain new access tokens.","found_in":"visible","note":null}},{"text":"Identify the required Dropbox API calls before selecting scopes.","evidence":{"label":"DOCS","source_id":"s1","quote":"Always ask for the least amount permissions required by your applications.","found_in":"visible","note":null}},{"text":"If the client secret cannot be stored securely, assess PKCE support for the application type.","evidence":{"label":"DOCS","source_id":"s1","quote":"Some types of applications may be unable to keep the client_secret secure.","found_in":"visible","note":null}}],"limits":[{"what":"App registrations per actual app","value":1.0,"unit":"app registration","scope":"each actual app","evidence":{"label":"DOCS","source_id":"s4","quote":"You should create one app registration per actual app that you are building.","found_in":"hidden_section","note":null}},{"what":"Registration process per app","value":1.0,"unit":"registration process","scope":"each app","evidence":{"label":"DOCS","source_id":"s4","quote":"That only needs to be done once per app so it should be manageable to do so manually.","found_in":"hidden_section","note":null}},{"what":"Maximum number of registered apps","value":null,"unit":"apps","scope":"developer","evidence":{"label":"DOCS","source_id":"s4","quote":"Dropbox does not limit how many apps you can register","found_in":"hidden_section","note":"No maximum is stated."}},{"what":"Required access-token size capability","value":1.0,"unit":"KB","scope":"Dropbox access token size; must support exceeding this size","evidence":{"label":"DOCS","source_id":"s2","quote":"Applications must support variable token size with tokens capable of exceeding 1KB.","found_in":"visible","note":null}},{"what":"OAuth state parameter size","value":2000.0,"unit":"bytes","scope":"OAuth state parameter","evidence":{"label":"DOCS","source_id":"s2","quote":"Up to 2000 bytes of arbitrary data that will be passed back to your redirect URI.","found_in":"visible","note":null}},{"what":"Access-token lifetime","value":null,"unit":"short-lived","scope":"Dropbox access token; exact expiration returned by the token endpoint or implicit-grant redirect","evidence":{"label":"DOCS","source_id":"s1","quote":"Dropbox access tokens are short lived, and will expire after a short period of time.","found_in":"visible","note":"No numeric duration is stated."}},{"what":"Refresh-token validity","value":null,"unit":"indefinite until revoked","scope":"Refresh token when no explicit expiration timestamp is requested","evidence":{"label":"DOCS","source_id":"s2","quote":"If this parameter is omitted, the refresh token will be valid indefinitely, until revoked.","found_in":"visible","note":null}}],"steps":[{"n":1,"title":"Sign in to the Dropbox developer console","detail":"Sign in with a real Dropbox developer account; the App Console requires authentication.","actor":"human","human_reason":"credential","irreversible":false,"values":[],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The supplied sign-in observation shows that https://www.dropbox.com/developers/apps redirects to the Dropbox login page."}},{"n":2,"title":"Register your own Dropbox app","detail":"Create one manually in the App Console for the actual app you are building, then complete the required application details.","actor":"human","human_reason":"submit","irreversible":true,"values":[],"evidence":{"label":"COMMUNITY","source_id":"s4","quote":"Dropbox also does not support registering apps programmatically. You should only be registering apps manually.","found_in":"hidden_section","note":null}},{"n":3,"title":"Register the exact Composio callback URI","detail":"Add Composio's callback as an exact redirect URI in the app's OAuth configuration; do not substitute a shortened or modified URL.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Redirect URI","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s1","quote":"You’ll need to register the exact redirect URI(s) your app may use in the App Console for your application.","found_in":"visible","note":null}},{"n":4,"title":"Select least-privilege scopes and OAuth behavior","detail":"Request only the permissions needed by the agent, and choose offline access if the agent must operate without a continuously present user.","actor":"either","human_reason":null,"irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s1","quote":"Always ask for the least amount permissions required by your applications.","found_in":"visible","note":"Offline access requires token_access_type=offline on the authorization URL."}},{"n":5,"title":"Complete the applicable approval review","detail":"If the workflow requires an app approval request, review the approval documentation, submit the relevant form, and wait for approval. Non-embedded Dropbox Sign workflows do not require an approval request, while embedded signing and Dropbox Sign OAuth workflows do.","actor":"human","human_reason":"wait","irreversible":true,"values":[],"evidence":{"label":"DOCS","source_id":"s3","quote":"If you’re implementing an embedded or Dropbox Sign OAuth workflow, you’ll need to review our app approval documentation and submit a request using the relevant form","found_in":"visible","note":"The same source states that non-embedded workflows do not need an approval request."}},{"n":6,"title":"Copy credentials into Composio","detail":"Obtain the registered app's client ID and client secret, then enter them into the Composio Dropbox authentication configuration together with the callback URI.","actor":"human","human_reason":"credential","irreversible":false,"values":[{"label":"Client ID","value":"Paste the client ID from your registered Dropbox app"},{"label":"Client secret","value":"Paste the client secret from your registered Dropbox app"},{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The supplied claims verify the provider-side callback and OAuth behavior, but not the current Composio field names or the standard Dropbox App Console location for the secret."}},{"n":7,"title":"Test the customer connection","detail":"Run a customer authorization through Composio, confirm the requested scopes and consent screen, and verify that token refresh works if the agent needs background access.","actor":"either","human_reason":null,"irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s1","quote":"These apps may instead use long-lived refresh tokens can be used to obtain new access tokens.","found_in":"visible","note":null}}],"review":{"required":"conditional","trigger":"Approval is required for embedded signing and Dropbox Sign OAuth workflows; non-embedded signing does not require an approval request.","submit":["Review Dropbox's app approval documentation and submit the relevant approval request.","For an embedded or Dropbox Sign OAuth workflow, remove test_mode from the API request after approval requirements are met."],"reviewer":"Dropbox","wait_official":null,"wait_community":null,"cost":null,"evidence":[{"label":"DOCS","source_id":"s3","quote":"If you’re implementing an embedded or Dropbox Sign OAuth workflow, you’ll need to review our app approval documentation and submit a request using the relevant form","found_in":"visible","note":null},{"label":"DOCS","source_id":"s3","quote":"If you’re implementing a non-embedded workflow, you don’t need to submit an approval request.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s3","quote":"If an API app isn’t approved, you can only use the API app in test_mode for embedded or OAuth workflows.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s3","quote":"You must be on a paid Dropbox Sign API Essentials plan or higher","found_in":"visible","note":"This is a non-embedded Dropbox Sign eligibility requirement, not a stated review fee."}]},"customer_gates":[{"text":"The authorizing customer must consent to the requested data sharing on Dropbox's authorization page.","evidence":{"label":"DOCS","source_id":"s1","quote":"This level of access is then communicated to the end user on the Dropbox app authorization page where the user consents to sharing their data.","found_in":"visible","note":null}},{"text":"A customer authorizing team scopes must be a team admin.","evidence":{"label":"UNCERTAIN","source_id":"s2","quote":null,"found_in":null,"note":"Downgraded from DOCS: quote not found on the source page. Original quote: \"The request will fail if this parameter is provided but not set to user or team, or if it is set to user but the scope contains team scope, or if it is set to team and the authorizing user is not a team admin.\"."}},{"text":"A non-embedded Dropbox Sign workflow requires a paid Dropbox Sign API Essentials plan or higher.","evidence":{"label":"DOCS","source_id":"s3","quote":"You must be on a paid Dropbox Sign API Essentials plan or higher","found_in":"visible","note":null}},{"text":"An authorization may be restricted to either a work team account or a personal Dropbox account.","evidence":{"label":"DOCS","source_id":"s2","quote":"If this parameter is specified, the user will be asked to authorize with a particular type of Dropbox account, either work for a team account or personal for a personal account.","found_in":"visible","note":null}}],"gotchas":[{"text":"The authorization redirect_uri must exactly match a registered value; list localhost explicitly when testing with it.","evidence":{"label":"DOCS","source_id":"s2","quote":"This must be the exact URI registered in the App Console; even ‘localhost’ must be listed if it is used for testing.","found_in":"visible","note":null}},{"text":"Online access returns a short-lived access token; use token_access_type=offline when a refresh token is required.","evidence":{"label":"DOCS","source_id":"s1","quote":"you’ll need to include token_access_type=offline as a parameter on your Authorization URL in order to return a refresh_token","found_in":"visible","note":null}},{"text":"A refresh token remains valid indefinitely until revoked unless explicit expiration is requested.","evidence":{"label":"DOCS","source_id":"s2","quote":"If this parameter is omitted, the refresh token will be valid indefinitely, until revoked.","found_in":"visible","note":null}},{"text":"The OAuth state parameter can contain at most 2,000 bytes of arbitrary data.","evidence":{"label":"DOCS","source_id":"s2","quote":"Up to 2000 bytes of arbitrary data that will be passed back to your redirect URI.","found_in":"visible","note":null}},{"text":"The authorization implementation must support access tokens larger than 1 KB.","evidence":{"label":"DOCS","source_id":"s2","quote":"Applications must support variable token size with tokens capable of exceeding 1KB.","found_in":"visible","note":null}},{"text":"One app registration can support different subsets of scopes requested at authorization time.","evidence":{"label":"COMMUNITY","source_id":"s4","quote":"you can request different subsets of scopes at authorization time, without creating multiple app registrations for the same actual app","found_in":"hidden_section","note":null}}],"blockers":[{"symptom":"Dropbox rejects the authorization or callback because the URI does not match.","cause":"The submitted redirect_uri differs from the value registered in the App Console.","fix":"Replace it with the exact registered callback, including its scheme, host, path, and any trailing characters.","evidence":{"label":"DOCS","source_id":"s1","quote":"Dropbox checks that the specified redirect_uri parameter in your Authorization URL matches one of the registered values","found_in":"visible","note":null}},{"symptom":"A Dropbox Sign embedded or OAuth workflow remains limited to test mode.","cause":"The API app has not completed the applicable approval request.","fix":"Review the approval documentation, submit the relevant form, and wait for approval before removing test_mode.","evidence":{"label":"DOCS","source_id":"s3","quote":"If an API app isn’t approved, you can only use the API app in test_mode for embedded or OAuth workflows.","found_in":"visible","note":null}},{"symptom":"The customer authorization request fails when team access is requested.","cause":"The authorizing customer is not a team admin.","fix":"Have a team admin authorize the team-scoped request or use user-scoped access instead.","evidence":{"label":"UNCERTAIN","source_id":"s2","quote":null,"found_in":null,"note":"Downgraded from DOCS: quote not found on the source page. Original quote: \"The request will fail if this parameter is provided but not set to user or team, or if it is set to user but the scope contains team scope, or if it is set to team and the authorizing user is not a team admin.\"."}}],"prepared":{"scopes":[{"scope":"Application-specific subset of Dropbox OAuth scopes","why":"The agent needs only the permissions required for its intended API calls.","review_class":"unknown"}],"privacy_policy_outline":["Identify the app owner and describe the data accessed, the purpose of access, storage practices, and deletion process.","Describe customer authorization, revocation, and support contact procedures.","Explain how customer data is used and whether it is shared with third parties."],"consent_screen":{"app_name":"Your registered Dropbox app name","requested_scopes":"List each selected scope and its purpose","data_access":"Describe the customer data the agent can access","authorization_action":"Authorize access","privacy_policy":"Link to the published privacy policy","support_contact":"Provide a support contact"},"review_text":"Explain the agent's Dropbox use case, requested scopes, least-privilege rationale, data handling, customer consent flow, and support process; submit the applicable Dropbox approval form when required."},"open_questions":["Does this integration use the standard Dropbox API App Console, Dropbox Sign API apps, or both?","Which exact Dropbox OAuth scopes are required by the agent's planned API calls?","Does the standard Dropbox app require a separate production-access or review process beyond the cited Dropbox Sign approval workflow?","What are the current App Console field names, secret-display behavior, and production toggle for the selected Dropbox product?","Which exact field names are currently shown in Composio's Dropbox BYO authentication configuration?","Is PKCE supported by the selected Dropbox OAuth flow and required for the intended deployment?"],"schema_version":"1","slug":"dropbox","app_name":"Dropbox","guide_type":"generated","last_verified":"2026-10-22","composio":{"toolkit_slug":"dropbox","status":"managed","callback_url":"https://backend.composio.dev/api/v3/toolkits/auth/callback","callback_note":"Copy the exact redirect URI shown in your Composio auth config; some toolkits still show the legacy https://backend.composio.dev/api/v1/auth-apps/add."},"wall_probe":{"console_url":"https://www.dropbox.com/developers/apps","final_url":"https://www.dropbox.com/login?cont=https%3A%2F%2Fwww.dropbox.com%2Fdevelopers%2Fapps","redirect_chain":["https://www.dropbox.com/developers/apps","https://www.dropbox.com/login?cont=https%3A%2F%2Fwww.dropbox.com%2Fdevelopers%2Fapps"],"outcome":"login_wall","wall_host":"www.dropbox.com","asks_for":"Sign-in page at www.dropbox.com","bot_check":false,"method":"http","observed_at":"2026-10-22"},"conflicts":[],"sources":[{"id":"s1","url":"https://docs.dropboxapi.com/dropbox-api/docs/oauth","title":"OAuth | Dropbox API Documentation","accessed":"2026-10-22","kind":"official_docs"},{"id":"s2","url":"https://docs.dropboxapi.com/dropbox-api/docs/get-started/authorization","title":"Authorization | Dropbox API Documentation","accessed":"2026-10-22","kind":"official_docs"},{"id":"s3","url":"https://help.dropbox.com/integrations/create-or-find-client-id-dropbox-sign","title":"Dropbox Sign API: Create or find your client ID - Dropbox Help","accessed":"2026-10-22","kind":"official_docs"},{"id":"s4","url":"https://community.dropbox.com/en/discussion/686245/dropbox-apps-limit","title":"Dropbox Apps limit - Dropbox Community","accessed":"2026-10-22","kind":"official_docs"},{"id":"s6","url":"https://www.dropbox.com/developers/apps","title":"Developer console sign-in wall probe","accessed":"2026-10-22","kind":"observation"}],"verification_summary":{"total":38,"tested":1,"docs_verified":29,"docs_hidden":3,"community":4,"uncertain":4}}}}

