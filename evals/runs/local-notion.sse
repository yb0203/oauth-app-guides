data: {"type":"data-guide","id":"guide","data":{"slug":"notion","permalink":"/guides/notion","guide":{"verdict":{"tier":"review_required","summary":"Register a Notion OAuth app and use the connection without review; Marketplace listing adds a conditional security review.","effort_hours":{"min":1.0,"max":2.0},"calendar":{"min_days":0.0,"max_days":null,"label":"Same-day setup; Marketplace review time is not stated"},"calendar_basis":"estimate","confidence":"medium"},"situations":{"questions":[{"id":"who_connects","text":"Who will connect to the Notion app?","options":[{"id":"own_org","label":"Only my organization or workspace"},{"id":"outside_users","label":"Outside users"}]},{"id":"agent_action","text":"What must the agent do?","options":[{"id":"read","label":"Read pages and databases"},{"id":"write","label":"Write or modify pages and databases"}]}],"variants":[{"when":{"who_connects":"own_org","agent_action":"read"},"tier":"instant","summary":"Create an internal connection scoped to one workspace and request read permissions.","calendar_label":"Same-day setup estimate","notes":[]},{"when":{"who_connects":"own_org","agent_action":"write"},"tier":"instant","summary":"Create an internal connection scoped to one workspace and request read/write permissions.","calendar_label":"Same-day setup estimate","notes":[]},{"when":{"who_connects":"outside_users","agent_action":"read"},"tier":"instant","summary":"A public connection can be used without Marketplace listing; each user authorizes it and selects accessible pages.","calendar_label":"Same-day setup estimate","notes":[]},{"when":{"who_connects":"outside_users","agent_action":"write"},"tier":"review_required","summary":"Listing for Marketplace distribution requires Notion security review; a public connection may otherwise be used without listing.","calendar_label":"Security-review wait: not stated","notes":[]}]},"byo_advice":"Composio's managed Notion app may be sufficient for a shared implementation; bring your own Notion OAuth app when you need your own client credentials, independently configured permissions, or separate credentials per connection. Public connections have separate credentials and permissions, while Marketplace eligibility depends on installation scope.","before_you_start":[{"text":"Decide whether the connection is internal to one workspace or public; internal connections are scoped to a single workspace.","evidence":{"label":"DOCS","source_id":"s4","quote":"Internal connections are scoped to a single workspace","found_in":"visible","note":null}},{"text":"Public installation scope can be any workspace or selected workspaces; a public connection's installation scope cannot be changed after creation.","evidence":{"label":"DOCS","source_id":"s2","quote":"either any workspace, or a specific set chosen at creation time.","found_in":"visible","note":null}},{"text":"Choose any workspace if Marketplace eligibility is required; selected-workspaces-only connections are not Marketplace-eligible.","evidence":{"label":"DOCS","source_id":"s4","quote":"Any workspace (any Notion user can install; Marketplace-eligible) or Selected workspaces only (restricted to workspaces you select; not Marketplace-eligible).","found_in":"visible","note":null}},{"text":"Have the OAuth client ID, client secret, authorized redirect URI, and exact scope strings ready before creating the Composio auth config.","evidence":{"label":"DOCS","source_id":"s3","quote":"create an OAuth app. Add the redirect URL from the previous step as an authorized redirect URI. Copy the client ID and client secret.","found_in":"visible","note":null}}],"limits":[{"what":"Internal connection workspace scope","value":1.0,"unit":"workspace","scope":"Internal connection installation","evidence":{"label":"DOCS","source_id":"s4","quote":"Internal connections are scoped to a single workspace","found_in":"visible","note":null}},{"what":"Default OAuth access-token expiry when the provider omits expires_in","value":3600000.0,"unit":"milliseconds","scope":"OAuth runtime configuration","evidence":{"label":"DOCS","source_id":"s3","quote":"Set accessTokenExpireMs to a sensible default (e.g., 3600000 for 1 hour) so the runtime knows when to refresh.","found_in":"visible","note":null}},{"what":"Example default OAuth access-token expiry","value":1.0,"unit":"hour","scope":"Example runtime configuration when expires_in is omitted","evidence":{"label":"DOCS","source_id":"s3","quote":"3600000 for 1 hour","found_in":"visible","note":null}}],"steps":[{"n":1,"title":"Sign in and open OAuth app settings","detail":"Sign in to the provider's developer console with the developer's account, open its OAuth app or integrations settings, and start a new OAuth app. The exact console URL and navigation labels were not available in the supplied evidence.","actor":"human","human_reason":"identity","irreversible":false,"values":[],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Verify the current Notion developer-console URL, sign-in requirements, and OAuth app creation location."}},{"n":2,"title":"Register your own OAuth app in the provider's developer console","detail":"Create an app (client) in the provider's developer console, fill in its name and description, and set its redirect URI to Composio's callback. Then copy the client ID and secret into a Composio auth config.","actor":"human","human_reason":"real_account","irreversible":false,"values":[{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s3","quote":"Call worker.oauth() with your provider’s OAuth 2.0 endpoints and credentials:","found_in":"visible","note":null}},{"n":3,"title":"Name the app and configure OAuth","detail":"Enter a unique name and configure the OAuth 2.0 authorization URL, token URL, client ID, client secret, and a space-separated scope list.","actor":"either","human_reason":null,"irreversible":true,"values":[{"label":"Authorization endpoint","value":"https://api.notion.com/v1/oauth/authorize"}],"evidence":{"label":"DOCS","source_id":"s3","quote":"name\nYes\nUnique identifier for this OAuth connection\nauthorizationEndpoint\nYes\nThe provider’s OAuth 2.0 authorization URL","found_in":"visible","note":null}},{"n":4,"title":"Register the Composio callback","detail":"Add Composio's callback as the authorized redirect URI. Confirm that the provider accepts it exactly as shown before saving.","actor":"human","human_reason":"submit","irreversible":true,"values":[{"label":"Authorized redirect URI","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The supplied Notion claims describe adding a provider OAuth redirect URL, but do not explicitly confirm that this Composio callback is accepted by Notion."}},{"n":5,"title":"Copy the app credentials","detail":"After the provider generates the app, copy its client ID and client secret into Composio's corresponding auth-config credential fields.","actor":"human","human_reason":"credential","irreversible":false,"values":[{"label":"Client ID","value":"<paste the OAuth app's client ID>"},{"label":"Client secret","value":"<paste the OAuth app's client secret>"}],"evidence":{"label":"DOCS","source_id":"s3","quote":"create an OAuth app. Add the redirect URL from the previous step as an authorized redirect URI. Copy the client ID and client secret.","found_in":"visible","note":null}},{"n":6,"title":"Choose the minimum scopes","detail":"Request only the scopes needed for the intended page and database operations, entered as a space-separated list. Verify the current scope names in the provider console.","actor":"either","human_reason":null,"irreversible":true,"values":[{"label":"Scope format","value":"Space-separated list of OAuth scopes"}],"evidence":{"label":"DOCS","source_id":"s3","quote":"scope\nYes\nSpace-separated list of OAuth scopes to request","found_in":"visible","note":null}},{"n":7,"title":"Save and test the connection","detail":"Save the Composio auth config and run one end-to-end authorization. Confirm that the user can select pages and that the resulting connection can perform only the approved operations.","actor":"human","human_reason":"real_account","irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s4","quote":"Connections are added to Notion workspaces and require explicit permission from users to access Notion pages and databases.","found_in":"visible","note":null}},{"n":8,"title":"Submit for public review if needed","detail":"For a public Marketplace listing, submit the connection for Notion's security review and wait for approval. A public connection can be created and used without Marketplace listing.","actor":"human","human_reason":"wait","irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s4","quote":"Public connections must undergo a Notion security review before being listed on the Marketplace.","found_in":"visible","note":null}}],"review":{"required":"conditional","trigger":"A public connection intended for Marketplace listing must pass Notion security review; a public connection can be used without listing.","submit":["Sign in to the Notion developer console and create an OAuth app.","Add the Composio callback URI shown for your auth config as the provider app's authorized redirect URI.","Request the required OAuth scopes as a space-separated list.","Copy the provider-issued client ID and client secret into the Composio auth config; the exact Composio field names must be checked in the current UI.","For each outside user, have them complete authorization and explicitly select the pages the connection may access.","Submit the public connection for Marketplace listing only if Marketplace distribution is needed."],"reviewer":null,"wait_official":null,"wait_community":null,"cost":null,"evidence":[{"label":"DOCS","source_id":"s4","quote":"Public connections must undergo a Notion security review before being listed on the Marketplace.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s4","quote":"You can create and use a public connection without listing it.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s3","quote":"create an OAuth app. Add the redirect URL from the previous step as an authorized redirect URI. Copy the client ID and client secret.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s3","quote":"scope\nYes\nSpace-separated list of OAuth scopes to request","found_in":"visible","note":null},{"label":"DOCS","source_id":"s4","quote":"Users choose which pages to share during the OAuth flow or via the Add connections menu.","found_in":"visible","note":null},{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The claims do not identify the exact Composio callback value, auth-config fields, Notion console URL, or required scope names; check the current Composio and Notion developer interfaces."}]},"customer_gates":[{"text":"Each Notion user must individually complete the authorization flow.","evidence":{"label":"DOCS","source_id":"s2","quote":"each prospective user needs to individually follow the auth flow for the connection.","found_in":"visible","note":null}},{"text":"Users explicitly choose which pages to share, including available private and public pages.","evidence":{"label":"DOCS","source_id":"s4","quote":"Users choose which pages to share during the OAuth flow or via the Add connections menu.","found_in":"visible","note":null}},{"text":"Selecting a parent page grants access to its available child pages, so users should review the page hierarchy before approving.","evidence":{"label":"DOCS","source_id":"s2","quote":"giving access to a parent page will provide access to all available child pages.","found_in":"visible","note":null}},{"text":"Workspace administrators may enforce organization access rules, but the supplied evidence does not state Notion's specific administrator controls.","evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Check the target workspace's administrator and third-party integration policies."}}],"gotchas":[{"text":"The redirect URI must match the authorized URI; cancellation returns to it with an error query parameter.","evidence":{"label":"DOCS","source_id":"s2","quote":"If the user presses Cancel, they will be redirected to the redirect URI with and error query param added.","found_in":"visible","note":null}},{"text":"If a token request supplied the redirect URI in the authorization URL or multiple redirect URIs are configured, include the redirect URI in the token request.","evidence":{"label":"DOCS","source_id":"s2","quote":"If the redirect URI was supplied as a query param in the Authorization URL, this field is required.","found_in":"visible","note":null}},{"text":"Notion's token endpoint returns an access token, refresh token, and additional information; refreshing produces both a new access token and a new refresh token.","evidence":{"label":"DOCS","source_id":"s2","quote":"Notion responds to the request with an access_token, refresh_token, and additional information.","found_in":"visible","note":null}},{"text":"If a provider omits expires_in, the OAuth runtime can use a one-hour default so it knows when to refresh.","evidence":{"label":"DOCS","source_id":"s3","quote":"Set accessTokenExpireMs to a sensible default (e.g., 3600000 for 1 hour) so the runtime knows when to refresh.","found_in":"visible","note":null}},{"text":"Treat the client secret as a secret rather than embedding it in code or logs.","evidence":{"label":"DOCS","source_id":"s3","quote":"Store your clientId and clientSecret as secrets, not in code:","found_in":"visible","note":null}},{"text":"A 401 may indicate an expired token; the documented worker recovery is to pull environment variables again for a refreshed token.","evidence":{"label":"DOCS","source_id":"s3","quote":"If you get a 401 from the provider, run ntn workers env pull again to get a refreshed token.","found_in":"visible","note":null}}],"blockers":[{"symptom":"Authorization returns to the callback with an error query parameter.","cause":"The user cancelled authorization, or the redirect URI may not match the registered value.","fix":"Check the callback error and verify that the authorized redirect URI exactly matches the value registered with the provider.","evidence":{"label":"DOCS","source_id":"s2","quote":"If the user presses Cancel, they will be redirected to the redirect URI with and error query param added.","found_in":"visible","note":null}},{"symptom":"The token exchange fails.","cause":"The redirect URI may be required in the token request, or the client ID and secret may not be correctly authorized.","fix":"Include the redirect URI when required and confirm that the token request uses the client ID and client secret with HTTP Basic Authentication.","evidence":{"label":"DOCS","source_id":"s2","quote":"The request is authorized using HTTP Basic Authentication.","found_in":"visible","note":null}},{"symptom":"A public connection cannot be listed on the Marketplace.","cause":"It has not passed Notion's security review, or it was configured for selected workspaces only.","fix":"Submit it for security review and use any-workspace installation scope if Marketplace eligibility is required.","evidence":{"label":"DOCS","source_id":"s4","quote":"Public connections must undergo a Notion security review before being listed on the Marketplace.","found_in":"visible","note":null}}],"prepared":{"scopes":[{"scope":"Exact Notion OAuth scope string for the minimum page/database read or write operations required","why":"Scopes are required and space-separated; use the smallest set that supports the intended operations.","review_class":"unknown"}],"privacy_policy_outline":["Identify the app, its provider, and the pages and databases it can access.","Explain that users select specific pages and that parent-page access may include available child pages.","Describe how selected data is used, retained, and deleted.","List the minimum OAuth scopes and explain why each is needed.","Provide support and incident-contact details."],"consent_screen":{"app_name":"Your app name","provider":"Notion","requested_access":"Read or write only the pages and databases the user selects","scope_details":"Show each exact Notion scope and a plain-language reason","page_selection":"Explain that users choose pages and that selecting a parent page includes its available child pages","authentication":"Explain that authorization uses OAuth 2.0 and that access can be revoked through Notion","privacy_policy":"Provide a link to the privacy policy","support_contact":"Provide a support contact"},"review_text":"If applying for a public Marketplace listing, explain the app's purpose, minimum scopes, user-selected page access, child-page implications, authentication flow, data handling, retention, deletion, and user revocation process."},"open_questions":["What is the current Notion developer-console URL and exact path for creating an OAuth app?","Does Notion accept https://backend.composio.dev/api/v3/toolkits/auth/callback unchanged as an authorized redirect URI?","Which exact Notion OAuth scope strings are required for the app's intended read and write operations?","What are the current Notion security-review submission URL, required artifacts, and review timing?","Which Composio auth-config fields and connection type should be selected for this Notion app?","Tier set to review_required by rule (model said instant) because the docs say: \"Public connections must undergo a Notion security review before being listed on the Marketplace.\""],"schema_version":"1","slug":"notion","app_name":"Notion","guide_type":"generated","last_verified":"2026-10-22","composio":{"toolkit_slug":"notion","status":"managed","callback_url":"https://backend.composio.dev/api/v3/toolkits/auth/callback","callback_note":"Copy the exact redirect URI shown in your Composio auth config; some toolkits still show the legacy https://backend.composio.dev/api/v1/auth-apps/add."},"wall_probe":null,"conflicts":[],"sources":[{"id":"s2","url":"https://developers.notion.com/guides/get-started/authorization","title":"Authorization - Notion Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s3","url":"https://developers.notion.com/workers/guides/oauth","title":"OAuth - Notion Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s4","url":"https://developers.notion.com/guides/get-started/overview","title":"Overview - Notion Docs","accessed":"2026-10-22","kind":"official_docs"}],"verification_summary":{"total":34,"tested":0,"docs_verified":30,"docs_hidden":0,"community":0,"uncertain":4}}}}

