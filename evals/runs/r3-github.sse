data: {"type":"data-guide","id":"guide","data":{"slug":"github","permalink":"/guides/github","guide":{"verdict":{"tier":"instant","summary":"Register your own GitHub OAuth app in Developer settings, configure Composio's callback URL and required scopes, then paste the client ID and secret into a Composio auth config. GitHub allows outside-organization users, but an organization with OAuth app access restrictions may require its owners' approval.","effort_hours":{"min":0.5,"max":1.5},"calendar":{"min_days":0.0,"max_days":null,"label":"Register and test immediately; organization approval may add external wait"},"calendar_basis":"estimate","confidence":"high"},"situations":{"questions":[{"id":"connectors","text":"Who will connect the GitHub app?","options":[{"id":"own_org","label":"Only my organization"},{"id":"internal_users","label":"Users inside my organization or enterprise"},{"id":"outside_users","label":"Users outside my organization or enterprise"}]},{"id":"actions","text":"What must the agent do?","options":[{"id":"read","label":"Read data"},{"id":"write","label":"Create or modify data"},{"id":"send","label":"Send messages or perform external actions"}]}],"variants":[{"when":{"connectors":"own_org","actions":"read"},"tier":"instant","summary":"Create the OAuth app under the personal account or an organization where you have administrative access, then test a read-only connection.","calendar_label":"Immediate registration and testing","notes":[]},{"when":{"connectors":"own_org","actions":"write"},"tier":"instant","summary":"Register the app and request only the write permissions and scopes needed; authorization is immediate unless organization restrictions apply.","calendar_label":"Immediate registration and testing","notes":[]},{"when":{"connectors":"internal_users","actions":"read"},"tier":"instant","summary":"Register the app for your organization and test the required read scopes.","calendar_label":"Immediate registration and testing","notes":[]},{"when":{"connectors":"outside_users","actions":"send"},"tier":"instant","summary":"Register the app for outside users and configure the needed write scopes. A restricted organization may require owner approval, while unapproved access is limited to public resources.","calendar_label":"Immediate registration; restricted organizations may require approval","notes":[]}]},"byo_advice":"Composio's managed app may be enough for a standard GitHub connection, but you should register your own app when you need developer-owned client credentials, callback configuration, or explicit scope control. For the bring-your-own path, sign in to GitHub, open Developer settings, select OAuth apps, create a New OAuth App, enter the required app name, Homepage URL, and Composio Authorization callback URL, request only the necessary scopes, enable device flow only if needed, and then paste the generated client ID and client secret into the Composio auth config.","before_you_start":[{"text":"The developer console needs a signed-in account: Sign-in page at github.com.","evidence":{"label":"TESTED","source_id":"s6","quote":null,"found_in":null,"note":"Our read-only probe on 2026-10-22 loaded https://github.com/settings/applications/new and ended at https://github.com/login?return_to=https%3A%2F%2Fgithub.com%2Fsettings%2Fapplications%2Fnew (login wall)."}},{"text":"The GitHub account must be personal or belong to an organization where you have administrative access.","evidence":{"label":"DOCS","source_id":"s3","quote":"You can create and register an OAuth app under your personal account or under any organization you have administrative access to.","found_in":"visible","note":null}},{"text":"Verify the account's email address before attempting OAuth authorization.","evidence":{"label":"DOCS","source_id":"s4","quote":"You must verify your email address before you can authorize an OAuth app.","found_in":"visible","note":null}},{"text":"A user or organization can own up to 100 OAuth apps.","evidence":{"label":"DOCS","source_id":"s3","quote":"A user or organization can own up to 100 OAuth apps.","found_in":"visible","note":null}},{"text":"Confirm the intended GitHub account and organization before registering the app because registration ownership is tied to that account or organization.","evidence":{"label":"DOCS","source_id":"s3","quote":"You can create and register an OAuth app under your personal account or under any organization you have administrative access to.","found_in":"visible","note":null}}],"limits":[{"what":"OAuth apps owned","value":100.0,"unit":"OAuth apps","scope":"Per user or organization","evidence":{"label":"DOCS","source_id":"s3","quote":"A user or organization can own up to 100 OAuth apps.","found_in":"visible","note":null}},{"what":"Callback URLs","value":10.0,"unit":"callback URLs","scope":"Per OAuth app","evidence":{"label":"DOCS","source_id":"s3","quote":"You can enter up to 10 callback URLs.","found_in":"visible","note":null}},{"what":"Temporary authorization code lifetime","value":10.0,"unit":"minutes","scope":"Temporary OAuth authorization code","evidence":{"label":"DOCS","source_id":"s2","quote":"The temporary code will expire after 10 minutes.","found_in":"visible","note":null}},{"what":"OAuth access token lifetime","value":8.0,"unit":"hours","scope":"OAuth access token","evidence":{"label":"DOCS","source_id":"s2","quote":"The access token expires after eight hours, and the refresh token expires after six months without use.","found_in":"visible","note":null}},{"what":"OAuth refresh token lifetime","value":6.0,"unit":"months","scope":"OAuth refresh token without use","evidence":{"label":"DOCS","source_id":"s2","quote":"The access token expires after eight hours, and the refresh token expires after six months without use.","found_in":"visible","note":null}},{"what":"Device verification code validity","value":15.0,"unit":"minutes","scope":"Device flow user verification code","evidence":{"label":"DOCS","source_id":"s2","quote":"The user must enter a valid code within 15 minutes (or 900 seconds). After 15 minutes, you will need to request a new device authorization code","found_in":"visible","note":null}},{"what":"Token creation rate limit","value":10.0,"unit":"tokens per hour","scope":"Token creation","evidence":{"label":"DOCS","source_id":"s4","quote":"and a rate limit of ten tokens created per hour.","found_in":"visible","note":null}},{"what":"Issued tokens","value":10.0,"unit":"tokens","scope":"Per user, application, and scope combination","evidence":{"label":"DOCS","source_id":"s4","quote":"There is a limit of ten tokens that are issued per user/application/scope combination","found_in":"visible","note":null}}],"steps":[{"n":1,"title":"Sign in to GitHub","detail":"Open GitHub Developer settings and sign in with the personal account, or an organization account where you have administrative access.","actor":"human","human_reason":"credential","irreversible":false,"values":[],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The observed new-app URL redirected unauthenticated visitors to GitHub's sign-in page."}},{"n":2,"title":"Create your OAuth app","detail":"In Developer settings, select OAuth apps and click New OAuth App.","actor":"human","human_reason":"real_account","irreversible":false,"values":[{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s3","quote":"In the left sidebar, click Developer settings.\nIn the left sidebar, click OAuth apps.\nClick New OAuth App.","found_in":"visible","note":null}},{"n":3,"title":"Complete the application details","detail":"Enter a unique application name and the full URL of your app's website. Draft these values before submitting them.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Application name","value":"Your agent application's name"},{"label":"Homepage URL","value":"https://your-app.example.com"}],"evidence":{"label":"DOCS","source_id":"s3","quote":"In \"Application name\", type the name of your app.","found_in":"visible","note":null}},{"n":4,"title":"Configure scopes and callback URL","detail":"Request only the scopes needed by the agent, then enter Composio's callback as the Authorization callback URL.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Authorization callback URL","value":"https://backend.composio.dev/api/v3/toolkit/auth/callback"},{"label":"Scopes","value":"Minimum provider scopes required by the agent's intended GitHub operations"},{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s3","quote":"In \"Authorization callback URL\", type the callback URL of your app.","found_in":"visible","note":"The scope description and callback field are supported by the cited GitHub documentation."}},{"n":5,"title":"Submit the app registration","detail":"Review the entered information and create the OAuth app through GitHub's developer console.","actor":"human","human_reason":"submit","irreversible":true,"values":[],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Check GitHub's current form for the final create/submit control and any provider-side review requirements."}},{"n":6,"title":"Configure Composio authentication","detail":"Copy the client ID and client secret generated for your app into the Composio GitHub auth configuration.","actor":"human","human_reason":"credential","irreversible":false,"values":[{"label":"Client ID","value":"The client ID generated for your own GitHub OAuth app"},{"label":"Client secret","value":"The client secret generated for your own GitHub OAuth app"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Verify where GitHub exposes these credentials and the current Composio auth-config labels."}},{"n":7,"title":"Obtain organizational approval when required","detail":"If the target organization restricts OAuth apps, submit the app for owner approval and wait for approval before expecting organizational access.","actor":"human","human_reason":"wait","irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s4","quote":"For organizations with OAuth app access restrictions, you can request that organization owners approve the application for use in that organization.","found_in":"visible","note":null}}],"review":{"required":"no","trigger":null,"submit":[],"reviewer":null,"wait_official":null,"wait_community":null,"cost":null,"evidence":[{"label":"DOCS","source_id":"s3","quote":"In the left sidebar, click Developer settings.\nIn the left sidebar, click OAuth apps.\nClick New OAuth App.","found_in":"visible","note":"GitHub documents self-service OAuth app registration; no provider review requirement is stated in the claims."},{"label":"DOCS","source_id":"s5","quote":"Your OAuth app can be accessed by users outside your organization or enterprise.","found_in":"visible","note":"Outside-organization use is supported without a stated app-review queue."},{"label":"DOCS","source_id":"s4","quote":"you should ensure you trust the application, review who it's developed by, and review the kinds of information the application wants to access.","found_in":"visible","note":"This is user review during authorization, not provider review of the app."},{"label":"DOCS","source_id":"s4","quote":"For organizations with OAuth app access restrictions, you can request that organization owners approve the application for use in that organization.","found_in":"visible","note":"Organization-owner approval may be required for organizational use, but this is distinct from provider app review."}]},"customer_gates":[{"text":"An organization with OAuth app access restrictions can require owner approval.","evidence":{"label":"DOCS","source_id":"s4","quote":"For organizations with OAuth app access restrictions, you can request that organization owners approve the application for use in that organization.","found_in":"visible","note":null}},{"text":"Without approval, a restricted organization exposes only its public resources to the app.","evidence":{"label":"DOCS","source_id":"s4","quote":"If the organization does not approve the application, then the application will only be able to access the organization's public resources.","found_in":"visible","note":null}},{"text":"Without OAuth app access restrictions, an app is automatically authorized for an organization's resources.","evidence":{"label":"DOCS","source_id":"s4","quote":"For organizations without OAuth app access restrictions, the application will automatically be authorized for access to that organization's resources.","found_in":"visible","note":null}},{"text":"A token cannot grant access beyond the permissions and scopes granted to it.","evidence":{"label":"DOCS","source_id":"s4","quote":"A token cannot grant additional access capabilities to a user.","found_in":"visible","note":null}}],"gotchas":[{"text":"OAuth access tokens expire after eight hours; refresh tokens expire after six months without use.","evidence":{"label":"DOCS","source_id":"s2","quote":"The access token expires after eight hours, and the refresh token expires after six months without use.","found_in":"visible","note":null}},{"text":"A temporary OAuth authorization code expires after 10 minutes.","evidence":{"label":"DOCS","source_id":"s2","quote":"The temporary code will expire after 10 minutes.","found_in":"visible","note":null}},{"text":"Creating more than ten tokens for the same user and scopes can cause GitHub to revoke an existing token with the same combination.","evidence":{"label":"DOCS","source_id":"s4","quote":"If an application creates more than ten tokens for the same user and the same scopes, GitHub revokes one of the existing tokens with the same user/application/scope combination","found_in":"visible","note":null}},{"text":"Token creation is rate-limited to ten tokens per hour.","evidence":{"label":"DOCS","source_id":"s4","quote":"and a rate limit of ten tokens created per hour.","found_in":"visible","note":null}},{"text":"An OAuth app supports up to 10 callback URLs.","evidence":{"label":"DOCS","source_id":"s3","quote":"You can enter up to 10 callback URLs.","found_in":"visible","note":null}},{"text":"Enable wildcard callback matching only when necessary and only when every possible subdomain and path is controlled.","evidence":{"label":"DOCS","source_id":"s1","quote":"Only enable wildcard matching if you absolutely need it and you are entirely certain that you control all possible subdomains and paths of the callback URL.","found_in":"visible","note":null}}],"blockers":[{"symptom":"Authorization fails because the account email is unverified.","cause":"GitHub requires a verified email before OAuth authorization.","fix":"Verify the account email, then repeat authorization.","evidence":{"label":"DOCS","source_id":"s4","quote":"You must verify your email address before you can authorize an OAuth app.","found_in":"visible","note":null}},{"symptom":"The callback exchange returns bad_refresh_token.","cause":"The refresh token is invalid or expired.","fix":"Repeat the web application or device flow to obtain new credentials.","evidence":{"label":"DOCS","source_id":"s2","quote":"If the refresh token that you specified is invalid or expired, you will receive a bad_refresh_token error. To resolve this error, send the user through the web application flow or device flow again","found_in":"visible","note":null}},{"symptom":"The callback is rejected because the returned state differs from the supplied state.","cause":"The authorization request may not have originated from the application.","fix":"Abort the authorization process and restart it with a newly generated state value.","evidence":{"label":"DOCS","source_id":"s2","quote":"If the states don't match, then a third party created the request, and you should abort the process.","found_in":"visible","note":null}}],"prepared":{"scopes":[{"scope":"Select the minimum provider scopes required for the agent's intended GitHub operations","why":"Scopes define access to public and non-public data, so broader scopes increase user and review burden.","review_class":"unknown"}],"privacy_policy_outline":["Identify the agent application and its developer.","Describe the GitHub data accessed, why it is accessed, and how it is stored and deleted.","Explain token handling, expiration, and user revocation."],"consent_screen":{"title":"Authorize Your Agent for GitHub","description":"Explain the selected GitHub scopes, the resources the agent can access, whether access is user-delegated or organizational, and how to revoke access.","authorize_button":"Authorize GitHub access"},"review_text":null},"open_questions":["Which GitHub operations and data categories does the agent require, so exact minimum scopes can be selected?","What is the application's real homepage URL?","Does GitHub currently impose any provider-side review requirements for this OAuth app?","Are the generated credentials obtained from the GitHub app's general settings page, and what are the current Composio auth-config field names?","What token-storage, refresh, and revocation behavior does the agent implementation provide?"],"schema_version":"1","slug":"github","app_name":"GitHub","guide_type":"generated","last_verified":"2026-10-22","composio":{"toolkit_slug":"github","status":"managed","callback_url":"https://backend.composio.dev/api/v3/toolkits/auth/callback","callback_note":"Copy the exact redirect URI shown in your Composio auth config; some toolkits still show the legacy https://backend.composio.dev/api/v1/auth-apps/add."},"wall_probe":{"console_url":"https://github.com/settings/applications/new","final_url":"https://github.com/login?return_to=https%3A%2F%2Fgithub.com%2Fsettings%2Fapplications%2Fnew","redirect_chain":["https://github.com/settings/applications/new","https://github.com/login?return_to=https%3A%2F%2Fgithub.com%2Fsettings%2Fapplications%2Fnew"],"outcome":"login_wall","wall_host":"github.com","asks_for":"Sign-in page at github.com","bot_check":false,"method":"http","observed_at":"2026-10-22"},"conflicts":[],"sources":[{"id":"s1","url":"https://docs.github.com/en/apps/creating-github-apps/about-creating-github-apps/best-practices-for-creating-a-github-app","title":"Best practices for creating a GitHub App - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s2","url":"https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authorizing-oauth-apps","title":"Authorizing OAuth apps - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s3","url":"https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app","title":"Creating an OAuth app - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s4","url":"https://docs.github.com/en/apps/oauth-apps/using-oauth-apps/authorizing-oauth-apps","title":"Authorizing OAuth apps - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s5","url":"https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/best-practices-for-creating-an-oauth-app","title":"Best practices for creating an OAuth app - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s6","url":"https://github.com/settings/applications/new","title":"Developer console sign-in wall probe","accessed":"2026-10-22","kind":"observation"}],"verification_summary":{"total":37,"tested":1,"docs_verified":33,"docs_hidden":0,"community":0,"uncertain":3}}}}

