data: {"type":"data-guide","id":"guide","data":{"slug":"notion","permalink":"/guides/notion","guide":{"verdict":{"tier":"review_required","summary":"Create a public Notion connection in the Notion integrations developer portal, choose its installation scope and capabilities, configure the exact callback URL supplied by Composio, then copy the OAuth client ID and secret into the Composio auth config. A public connection can be used without Marketplace listing, but Marketplace listing requires Notion security review.","effort_hours":{"min":1.0,"max":3.0},"calendar":{"min_days":0.0,"max_days":null,"label":"App creation may be immediate; Marketplace or higher-limit review has no stated wait"},"calendar_basis":"estimate","confidence":"low"},"situations":{"questions":[{"id":"audience","text":"Who will connect the Notion app?","options":[{"id":"own_org","label":"My organization or a small team"},{"id":"outside_users","label":"Outside users or multiple workspaces"}]},{"id":"actions","text":"What must the agent do?","options":[{"id":"read","label":"Read permitted pages and databases"},{"id":"write","label":"Insert or update content"}]}],"variants":[{"when":{"audience":"own_org","actions":"read"},"tier":"unknown","summary":"Register a public Notion connection, restrict installation to selected workspaces, configure the required capabilities, and require user permission for each shared page or database.","calendar_label":"Registration effort estimated; no official wait stated","notes":[]},{"when":{"audience":"own_org","actions":"write"},"tier":"unknown","summary":"Register a public Notion connection with the content capabilities needed for insertion or updates; users must share the target pages or databases explicitly.","calendar_label":"Registration effort estimated; no official wait stated","notes":[]},{"when":{"audience":"outside_users","actions":"read"},"tier":"unknown","summary":"Register a public Notion connection with read capabilities; the installation scope controls who can install it, and users must explicitly permit access to selected content.","calendar_label":"Registration effort estimated; Marketplace review only if listed","notes":[]},{"when":{"audience":"outside_users","actions":"write"},"tier":"unknown","summary":"Register a public Notion connection with write capabilities and OAuth page selection; Marketplace listing requires Notion security review, while unlisted public connections can still be created and used.","calendar_label":"Registration effort estimated; review wait is not stated","notes":[]}]},"byo_advice":"Composio's managed Notion app is enough for a quick evaluation or simple shared-workspace use. Bring your own Notion connection when you need your own OAuth client credentials, installation-scope choices, content capabilities, or a public distribution path.","before_you_start":[{"text":"Choose whether the app is intended for many Notion users or workspaces; public connections are intended for that use case.","evidence":{"label":"DOCS","source_id":"s2","quote":"Apps or services used by many Notion users or workspaces.","found_in":"visible","note":null}},{"text":"Decide the installation scope before creating the connection because it is selected at creation time.","evidence":{"label":"DOCS","source_id":"s2","quote":"At creation time, you choose their installation scope","found_in":"visible","note":null}},{"text":"For Marketplace eligibility, use the Any workspace installation scope rather than Selected workspaces only.","evidence":{"label":"DOCS","source_id":"s2","quote":"Any workspace (any Notion user can install; Marketplace-eligible)","found_in":"visible","note":null}},{"text":"Public connections use OAuth 2.0, including authorization, token exchange, and access-token refresh.","evidence":{"label":"DOCS","source_id":"s2","quote":"Public connections use OAuth 2.0 for authentication.","found_in":"visible","note":null}},{"text":"A public connection can be created and used without being listed on the Marketplace.","evidence":{"label":"DOCS","source_id":"s2","quote":"You can create and use a public connection without listing it.","found_in":"visible","note":null}}],"limits":[{"what":"Default request rate","value":3.0,"unit":"requests per second","scope":"per Notion integration","evidence":{"label":"COMMUNITY","source_id":"s5","quote":"you can make up to 3 requests per second for a given integration","found_in":"visible","note":null}},{"what":"Internal integration request rate","value":3.0,"unit":"requests per second","scope":"per integration per workspace for internal integrations","evidence":{"label":"COMMUNITY","source_id":"s4","quote":"The default limit for internal integrations is 3 requests per second per integration per workspace.","found_in":"visible","note":null}},{"what":"Public integration request rate without higher-limit approval","value":3.0,"unit":"requests per second","scope":"per integration per workspace for public integrations without higher-limit approval","evidence":{"label":"COMMUNITY","source_id":"s4","quote":"For public integrations that haven’t been approved for higher limits, it’s the same.","found_in":"visible","note":null}},{"what":"Free-plan workspace request rate","value":10.0,"unit":"requests per second","scope":"per integration for Free-plan workspaces","evidence":{"label":"COMMUNITY","source_id":"s4","quote":"Free plan workspaces are limited to 10 requests per second per integration.","found_in":"visible","note":null}},{"what":"Plus-plan workspace request rate","value":25.0,"unit":"requests per second","scope":"per integration for Plus-plan workspaces","evidence":{"label":"COMMUNITY","source_id":"s4","quote":"Plus plan? You jump to 25 requests per second.","found_in":"visible","note":null}},{"what":"Rate-limit rejection response","value":429.0,"unit":"HTTP status code","scope":"requests exceeding the rate limit","evidence":{"label":"COMMUNITY","source_id":"s5","quote":"Exceed that, and you’ll get a 429 status code, and your requests will be rejected until the limit resets.","found_in":"visible","note":null}}],"steps":[{"n":1,"title":"Sign in to Notion's developer console","detail":"Sign in with a real Notion account and open the integrations developer console; the console URL was not verified from the supplied sources.","actor":"human","human_reason":"credential","irreversible":false,"values":[],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Verify the current Notion integrations developer console URL and sign-in requirements."}},{"n":2,"title":"Register your own OAuth app in the provider's developer console","detail":"Create an app (client) in the provider's developer console, fill in its name and description, and set its redirect URI to Composio's callback. Then copy the client ID and secret into a Composio auth config.","actor":"human","human_reason":"real_account","irreversible":false,"values":[{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s2","quote":"At creation time, you choose their installation scope","found_in":"visible","note":null}},{"n":3,"title":"Register a public OAuth connection","detail":"Create a new public connection in Notion's developer console and provide a connection name and workspace details.","actor":"human","human_reason":"real_account","irreversible":false,"values":[{"label":"Connection name","value":"Your product or integration name"},{"label":"Workspace details","value":"Your product URL and support contact details"}],"evidence":{"label":"COMMUNITY","source_id":"s3","quote":"Create a new public connection.","found_in":"visible","note":null}},{"n":4,"title":"Choose the installation scope","detail":"Select the installation scope carefully at creation time. Choose Any workspace if the app should be installable by any Notion user and eligible for the Marketplace; Selected workspaces only restricts installation and is not Marketplace-eligible.","actor":"either","human_reason":null,"irreversible":true,"values":[{"label":"Marketplace-eligible installation scope","value":"Any workspace (any Notion user can install; Marketplace-eligible)"},{"label":"Restricted installation scope","value":"Selected workspaces only (restricted to workspaces you select; not Marketplace-eligible)"}],"evidence":{"label":"DOCS","source_id":"s2","quote":"At creation time, you choose their installation scope","found_in":"visible","note":null}},{"n":5,"title":"Configure the OAuth redirect URI","detail":"Enter Composio's callback URL in Notion's OAuth redirect URI configuration. The value must be copied exactly.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"OAuth redirect URI","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The supplied claims describe other callback formats, but none verifies the required Composio callback URI; confirm that Notion accepts this exact URL."}},{"n":6,"title":"Configure OAuth capabilities","detail":"Configure the content capabilities needed by the Composio actions. Start with read_content, insert_content, and update_content, and remove capabilities that the agent does not require.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Minimum documented content capabilities","value":"read_content, insert_content, update_content"}],"evidence":{"label":"COMMUNITY","source_id":"s3","quote":"OpenConnector’s Notion OAuth provider requests capabilities such as read_content, insert_content, and update_content.","found_in":"visible","note":null}},{"n":7,"title":"Copy credentials and configure Composio","detail":"Copy the OAuth client ID and client secret from Notion's public connection settings, then paste both into the Notion auth configuration in Composio. Keep the secret out of source control and logs.","actor":"human","human_reason":"credential","irreversible":false,"values":[{"label":"Notion OAuth client ID","value":"Copy from Notion public connection settings"},{"label":"Notion OAuth client secret","value":"Copy from Notion public connection settings"}],"evidence":{"label":"COMMUNITY","source_id":"s3","quote":"From the Notion public connection settings, copy:","found_in":"visible","note":null}},{"n":8,"title":"Submit for review and test the connection","detail":"Submit the public connection for Notion's security review and wait for its decision. A public connection can be used without Marketplace listing, but Marketplace listing requires this review.","actor":"human","human_reason":"wait","irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s2","quote":"Public connections must undergo a Notion security review before being listed on the Marketplace.","found_in":"visible","note":null}}],"review":{"required":"conditional","trigger":"Notion security review is required for Marketplace listing; a separate Notion review is also cited as a prerequisite for boosted rate limits.","submit":["Submit the public connection for Notion security review when requesting Marketplace listing or higher rate limits."],"reviewer":"Notion","wait_official":null,"wait_community":null,"cost":null,"evidence":[{"label":"DOCS","source_id":"s2","quote":"Public connections must undergo a Notion security review before being listed on the Marketplace.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s2","quote":"You can create and use a public connection without listing it.","found_in":"visible","note":null},{"label":"COMMUNITY","source_id":"s4","quote":"If you’ve built a public integration and gone through Notion’s review process, you can get boosted limits.","found_in":"visible","note":null},{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Check the Notion developer console and Composio auth config for the current submission requirements, applicable rate-limit plan, and callback URL; no console URL, review wait, or boosted limit was supplied."}]},"customer_gates":[{"text":"Each Notion user must explicitly permit the connection before it can access their pages and databases.","evidence":{"label":"DOCS","source_id":"s2","quote":"Connections are added to Notion workspaces and require explicit permission from users to access Notion pages and databases.","found_in":"visible","note":null}},{"text":"During OAuth authorization, the user selects which pages to grant the connection access to.","evidence":{"label":"DOCS","source_id":"s2","quote":"Public connections use the OAuth page picker, where users select which pages to grant access to during the authorization flow.","found_in":"visible","note":null}},{"text":"Notion access is limited to the pages or databases the user shares during authorization.","evidence":{"label":"COMMUNITY","source_id":"s3","quote":"During authorization, select the pages or databases the connection should access. Notion access is scoped to shared content.","found_in":"visible","note":null}},{"text":"A workspace owner may restrict OAuth scopes, potentially reducing the connection's effective capabilities and rate limit.","evidence":{"label":"COMMUNITY","source_id":"s4","quote":"Some integrations use OAuth, and the workspace owner might restrict scopes. That can silently lower the effective limit.","found_in":"visible","note":null}}],"gotchas":[{"text":"The redirect URI must match exactly; verify the pasted Composio callback rather than using a community guide's OpenConnector callback.","evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The supplied redirect claims concern OpenConnector and do not verify the required Composio URL."}},{"text":"The public OAuth flow includes authorization, token exchange, and access-token refresh; store the refresh token securely and refresh before expiration.","evidence":{"label":"COMMUNITY","source_id":"s5","quote":"If you store the refresh token securely and implement the refresh call before the access token expires, you’ll maintain a seamless connection without user intervention.","found_in":"visible","note":null}},{"text":"A public integration without approved higher limits is documented at 3 requests per second per integration per workspace.","evidence":{"label":"COMMUNITY","source_id":"s4","quote":"For public integrations that haven’t been approved for higher limits, it’s the same.","found_in":"visible","note":null}},{"text":"After HTTP 429, wait for the duration specified by the Retry-After header before retrying.","evidence":{"label":"COMMUNITY","source_id":"s5","quote":"wait for the duration specified in the Retry-After header before retrying","found_in":"visible","note":null}},{"text":"An HTTP 404 for a page can indicate that the integration lacks permission to see it, even when the page exists.","evidence":{"label":"COMMUNITY","source_id":"s5","quote":"The API returns a 404 not because the page doesn’t exist, but because the integration lacks permission to see it.","found_in":"visible","note":null}}],"blockers":[{"symptom":"Notion rejects the configured redirect URI.","cause":"The entered URI does not exactly match the callback expected by Composio.","fix":"Replace it with https://backend.composio.dev/api/v3/toolkits/auth/callback and ensure there are no trailing spaces or extra characters.","evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The exact-match behavior is documented for another callback in the supplied claims, while the required Composio callback was not independently verified."}},{"symptom":"Requests return HTTP 429.","cause":"The integration exceeded its applicable request rate.","fix":"Wait for the Retry-After duration, then retry with request throttling.","evidence":{"label":"COMMUNITY","source_id":"s5","quote":"Exceed that, and you’ll get a 429 status code, and your requests will be rejected until the limit resets.","found_in":"visible","note":null}},{"symptom":"A known page or database returns HTTP 404.","cause":"The user did not share that content with the integration or did not grant the required permission.","fix":"Have the user reselect the page or database in Notion's OAuth page picker and verify the connection's capabilities.","evidence":{"label":"COMMUNITY","source_id":"s5","quote":"The API returns a 404 not because the page doesn’t exist, but because the integration lacks permission to see it.","found_in":"visible","note":null}}],"prepared":{"scopes":[{"scope":"read_content","why":"Read content from pages and databases explicitly shared by the user.","review_class":"unknown"},{"scope":"insert_content","why":"Create content in pages and databases explicitly shared by the user.","review_class":"unknown"},{"scope":"update_content","why":"Modify content in pages and databases explicitly shared by the user.","review_class":"unknown"}],"privacy_policy_outline":["State that the app accesses only Notion content selected by the user during authorization.","Describe how access tokens and refresh tokens are stored, refreshed, and revoked.","Explain the purposes for reading, inserting, and updating Notion content.","Provide a support contact and a method for requesting access removal."],"consent_screen":{"title":"Connect your Notion workspace","description":"Select the Notion pages and databases your agent should access. Access is limited to the content you share.","requested_capabilities":"Read content, insert content, and update content in the pages and databases you select.","privacy_policy":"Provide a link to the app's privacy policy.","cancel_action":"Cancel without granting access."},"review_text":"This public OAuth integration is intended for use by many Notion users and workspaces. It requests only the content capabilities needed for supported agent actions, uses OAuth 2.0, and requires users to select the pages and databases the connection may access through Notion's OAuth page picker."},"open_questions":["What is the current URL and exact sign-in flow for Notion's integrations developer console?","Does Notion accept https://backend.composio.dev/api/v3/toolkits/auth/callback as an exact OAuth redirect URI, and are any additional redirect or HTTPS rules required?","Which Notion capability names are currently selectable, and which are the minimum capabilities required by the intended Composio actions?","What Notion security-review criteria, submission fields, and approval timeline apply to this app?","How do Notion workspace plan, owner-imposed scope restrictions, and public-integration review status interact when determining the effective request-rate limit?","Tier set to review_required by rule (model said unknown) because the docs say: \"Public connections must undergo a Notion security review before being listed on the Marketplace.\""],"schema_version":"1","slug":"notion","app_name":"Notion","guide_type":"generated","last_verified":"2026-10-22","composio":{"toolkit_slug":"notion","status":"managed","callback_url":"https://backend.composio.dev/api/v3/toolkits/auth/callback","callback_note":"Copy the exact redirect URI shown in your Composio auth config; some toolkits still show the legacy https://backend.composio.dev/api/v1/auth-apps/add."},"wall_probe":null,"conflicts":[],"sources":[{"id":"s2","url":"https://developers.notion.com/guides/get-started/overview","title":"Overview - Notion Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s3","url":"https://oomol.com/docs/openconnector-notion-oauth-app/","title":"Create a Notion OAuth app for OpenConnector | OOMOL","accessed":"2026-10-22","kind":"community"},{"id":"s4","url":"https://ones.com/blog/demystifying-notion-api-rate-limits-a-clear-documentation-walkthrough/","title":"Notion API Rate Limits: Documentation Walkthrough","accessed":"2026-10-22","kind":"community"},{"id":"s5","url":"https://ones.com/blog/understanding-the-notion-rest-api-documentation-authentication-and-rate-limits/","title":"Understanding the Notion REST API Documentation: Authentication and Rate Limits","accessed":"2026-10-22","kind":"community"}],"verification_summary":{"total":35,"tested":0,"docs_verified":12,"docs_hidden":0,"community":18,"uncertain":5}}}}

