data: {"type":"data-guide","id":"guide","data":{"slug":"todoist","permalink":"/guides/todoist","guide":{"verdict":{"tier":"unknown","summary":"Register your own Todoist OAuth client and configure it for Composio. Todoist documents OAuth client registration, but the claims do not establish whether developer-console apps require provider review.","effort_hours":{"min":0.5,"max":1.5},"calendar":{"min_days":0.0,"max_days":null,"label":"Same-day setup; provider review timing is unverified"},"calendar_basis":"estimate","confidence":"low"},"situations":{"questions":[{"id":"connectors","text":"Who will connect to Todoist?","options":[{"id":"own_org","label":"Only my organization"},{"id":"outside_users","label":"Users outside my organization"}]},{"id":"actions","text":"What must the agent do?","options":[{"id":"read","label":"Read tasks and projects"},{"id":"write","label":"Create or modify tasks"},{"id":"send","label":"Create and modify tasks, including deleting data"}]}],"variants":[{"when":{"connectors":"own_org","actions":"read"},"tier":"unknown","summary":"Register a read-only client and connect it through Composio.","calendar_label":"Same-day setup; review requirement unverified","notes":["Use the data:read scope."]},{"when":{"connectors":"outside_users","actions":"read"},"tier":"unknown","summary":"Register a read-only client for outside users; verify whether Todoist reviews it.","calendar_label":"Same-day setup; provider review timing unverified","notes":["Todoist says OAuth is intended for integrations built for other people."]},{"when":{"connectors":"outside_users","actions":"write"},"tier":"unknown","summary":"Register a task-writing client and verify the provider's review and distribution requirements.","calendar_label":"Same-day setup; provider review timing unverified","notes":["Use task:add for task creation."]},{"when":{"connectors":"own_org","actions":"send"},"tier":"unknown","summary":"Register a client with write and delete permissions; confirm the narrowest acceptable scope set.","calendar_label":"Same-day setup; review requirement unverified","notes":["Delete scopes materially expand access and should be included only when required."]}]},"byo_advice":"Composio's managed app may be enough for a quick proof of concept or standard integrations. Bring your own Todoist app when you need your own client identity, scoped permissions, branding, or distribution control.","before_you_start":[{"text":"The developer console needs a signed-in account: Page at app.todoist.com loaded but shows no readable content over plain HTTP (a JavaScript app), so a sign-in prompt could not be observed.","evidence":{"label":"TESTED","source_id":"s4","quote":null,"found_in":null,"note":"Our read-only probe on 2026-10-22 loaded https://app.todoist.com/app/settings/integrations/app-management and ended at https://app.todoist.com/app/settings/integrations/app-management (console reachable)."}},{"text":"Todoist supports OAuth authorization for integrations built for other people.","evidence":{"label":"DOCS","source_id":"s3","quote":"Building for other people? Use OAuth authorization instead of a personal token.","found_in":"visible","note":null}},{"text":"The Todoist developer platform is free to use with any Todoist account.","evidence":{"label":"DOCS","source_id":"s3","quote":"Free to use with any Todoist account.","found_in":"visible","note":null}},{"text":"Todoist advertises dynamic client registration at its registration endpoint.","evidence":{"label":"DOCS","source_id":"s1","quote":"\"client_registration_types_supported\":[\"dynamic\"]","found_in":"visible","note":null}}],"limits":[{"what":"Access-token lifetime for dynamically registered OAuth applications","value":1.0,"unit":"hour","scope":"Dynamically registered OAuth application access tokens","evidence":{"label":"DOCS","source_id":"s2","quote":"tokens issued to these applications expire one hour after they are issued","found_in":"visible","note":null}},{"what":"Client-secret expiration","value":0.0,"unit":"seconds","scope":"Dynamically registered OAuth client secrets","evidence":{"label":"DOCS","source_id":"s2","quote":"The\nclient_secret_expires_at field is 0 — client secrets do not expire.","found_in":"visible","note":null}},{"what":"Refresh scope cannot exceed the original grant","value":null,"unit":"scopes","scope":"Token refresh","evidence":{"label":"DOCS","source_id":"s2","quote":"A comma separated subset of the originally granted scopes. Clients may request a narrower set of scopes; requesting scopes beyond the original grant returns an error.","found_in":"visible","note":null}}],"steps":[{"n":1,"title":"Sign in to Todoist","detail":"Open Todoist's developer app-management area and sign in with the Todoist account that will own the OAuth client.","actor":"human","human_reason":"credential","irreversible":false,"values":[{"label":"App-management URL","value":"https://app.todoist.com/app/settings/integrations/app-management"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The sign-in wall was not readable over plain HTTP; confirm the console's current sign-in and app-creation flow."}},{"n":2,"title":"Register your own Todoist app","detail":"Create a new OAuth client in the Todoist developer console or use Todoist's dynamic client registration endpoint.","actor":"human","human_reason":"submit","irreversible":false,"values":[{"label":"Dynamic registration endpoint","value":"https://todoist.com/oauth/register"}],"evidence":{"label":"DOCS","source_id":"s1","quote":"\"client_registration_types_supported\":[\"dynamic\"]","found_in":"visible","note":null}},{"n":3,"title":"Enter the app identity","detail":"Provide a client name and, if requested, client URI and logo URI. Use your own application's identity rather than Todoist's hosted MCP name.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Client name","value":"Your application name"}],"evidence":{"label":"DOCS","source_id":"s1","quote":"\"client_metadata_supported\":[\"client_name\",\"client_uri\",\"logo_uri\",\"redirect_uris\",\"scope\",\"grant_types\",\"response_types\",\"token_endpoint_auth_method\"]","found_in":"visible","note":null}},{"n":4,"title":"Configure the redirect URI and grants","detail":"Add Composio's callback as the OAuth redirect URI and configure the authorization-code and refresh-token grants.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Redirect URI","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"},{"label":"Grant types","value":"authorization_code, refresh_token"}],"evidence":{"label":"DOCS","source_id":"s2","quote":"Must include authorization_code. Include refresh_token to use token refresh.","found_in":"visible","note":null}},{"n":5,"title":"Choose minimal scopes","detail":"Request only the scopes required by the agent, such as read access, task creation, or deletion access.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Supported scopes","value":"task:add, data:read, data:read_write, data:delete, project:delete"}],"evidence":{"label":"UNCERTAIN","source_id":"s1","quote":null,"found_in":null,"note":"Downgraded from DOCS: quote not found on the source page. Original quote: \"\"scopes_supported\":[\"task:add\",\"data:read\",\"data:read_write\",\"data:delete\",\"project:delete\"]\"."}},{"n":6,"title":"Copy the client credentials","detail":"Retrieve the client ID and client secret from the registered app and store them securely.","actor":"human","human_reason":"credential","irreversible":false,"values":[{"label":"Client ID","value":"Paste the Todoist client_id"},{"label":"Client secret","value":"Paste the Todoist client_secret"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Confirm where the current console displays and rotates the credentials for a self-registered client."}},{"n":7,"title":"Configure Composio and test","detail":"Paste the client ID and secret into the Composio Todoist auth configuration, then test authorization and the required task or project operations.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Composio redirect URI","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s2","quote":"It's especially useful for\nexternal applications to obtain a user authorized API token via the OAuth2\nprotocol.","found_in":"visible","note":null}}],"review":{"required":"conditional","trigger":"Check whether Todoist requires review for the selected scopes or for distribution to users outside your organization.","submit":["Submit the app and scope details through the Todoist developer console if the console requests approval."],"reviewer":null,"wait_official":null,"wait_community":null,"cost":null,"evidence":[{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The supplied claims do not state whether developer-console apps undergo review or how long review takes."}]},"customer_gates":[{"text":"Each user must authorize the app through Todoist's OAuth authorization flow.","evidence":{"label":"DOCS","source_id":"s2","quote":"When the user denies your authorization request, Todoist will redirect the user to the configured redirect URI with the error parameter: http://example.com?error=access_denied.","found_in":"visible","note":null}},{"text":"Todoist can use the configured redirect URI to return authorization errors.","evidence":{"label":"DOCS","source_id":"s2","quote":"When the user denies your authorization request, Todoist will redirect the user to the configured redirect URI with the error parameter: http://example.com?error=access_denied.","found_in":"visible","note":null}}],"gotchas":[{"text":"An invalid scope returns invalid_scope through the redirect URI.","evidence":{"label":"DOCS","source_id":"s2","quote":"When the scope parameter is invalid, Todoist will redirect the user to the configured redirect URI with error parameter: http://example.com?error=invalid_scope.","found_in":"visible","note":null}},{"text":"Missing or incorrect client credentials return invalid_client.","evidence":{"label":"DOCS","source_id":"s2","quote":"The client_id or client_secret is missing or incorrect: {\"error\": \"invalid_client\"}.","found_in":"visible","note":null}},{"text":"Incorrectly submitted client credentials can produce incorrect_application_credentials.","evidence":{"label":"DOCS","source_id":"s2","quote":"Occurs when the client_id or client_secret parameters are incorrect: {\"error\": \"incorrect_application_credentials\"}","found_in":"visible","note":null}},{"text":"Refresh tokens rotate after every successful refresh and must replace the previous token.","evidence":{"label":"DOCS","source_id":"s2","quote":"Refresh tokens are rotated on every successful refresh. The refresh token\nreturned in the response replaces the one you just used","found_in":"visible","note":null}},{"text":"An unusable refresh token requires the user to authorize the application again.","evidence":{"label":"DOCS","source_id":"s2","quote":"The refresh token is unknown, expired, revoked, or has already been consumed outside the grace window: {\"error\": \"invalid_grant\"}. The user must re-authorize the application.","found_in":"visible","note":null}}],"blockers":[{"symptom":"Authorization fails with invalid_scope.","cause":"The requested scope is invalid or unsupported.","fix":"Use only documented scopes and submit them as the correct scope parameter.","evidence":{"label":"DOCS","source_id":"s2","quote":"When the scope parameter is invalid, Todoist will redirect the user to the configured redirect URI with error parameter: http://example.com?error=invalid_scope.","found_in":"visible","note":null}},{"symptom":"Token exchange fails with invalid_client or incorrect_application_credentials.","cause":"The client ID or client secret is missing or incorrect.","fix":"Copy both credentials again and verify that they belong to the client with Composio's callback registered.","evidence":{"label":"DOCS","source_id":"s2","quote":"The client_id or client_secret is missing or incorrect: {\"error\": \"invalid_client\"}.","found_in":"visible","note":null}},{"symptom":"Refresh fails with invalid_grant and asks the user to authorize again.","cause":"The refresh token is unknown, expired, revoked, or was already consumed outside the grace window.","fix":"Re-authorize the user and replace the stored refresh token after every successful refresh.","evidence":{"label":"DOCS","source_id":"s2","quote":"The refresh token is unknown, expired, revoked, or has already been consumed outside the grace window: {\"error\": \"invalid_grant\"}. The user must re-authorize the application.","found_in":"visible","note":null}}],"prepared":{"scopes":[{"scope":"data:read","why":"Minimum scope for reading Todoist data.","review_class":"unknown"},{"scope":"task:add","why":"Minimum documented scope for creating tasks.","review_class":"unknown"},{"scope":"data:read_write","why":"Use when the agent must modify Todoist data beyond adding tasks.","review_class":"sensitive"},{"scope":"data:delete","why":"Use only when the agent must delete Todoist data.","review_class":"restricted"},{"scope":"project:delete","why":"Use only when the agent must delete projects.","review_class":"restricted"}],"privacy_policy_outline":["Identify the app operator and describe the Todoist data accessed.","Explain whether data is read, modified, or deleted and how it is retained.","Describe OAuth token storage, revocation, support, and deletion procedures."],"consent_screen":{"app_name":"Your application name","requested_scopes":"Show each requested scope and its purpose","todoist_account":"Display the account that will be connected","authorization_actions":"Explain that the user can deny access","privacy_policy":"Link to your privacy policy","support_contact":"Provide a support or contact method"},"review_text":null},"open_questions":["Does the current Todoist developer console permit creating a custom OAuth app, and what fields are required?","Does Todoist review self-registered applications or sensitive scopes?","What is the official review turnaround time?","Does a self-registered client use the same token lifetime and secret-expiration rules as dynamically registered clients?","Which response type and token-endpoint authentication method does Composio require for a confidential client?"],"schema_version":"1","slug":"todoist","app_name":"Todoist","guide_type":"generated","last_verified":"2026-10-22","composio":{"toolkit_slug":"todoist","status":"managed","callback_url":"https://backend.composio.dev/api/v3/toolkits/auth/callback","callback_note":"Copy the exact redirect URI shown in your Composio auth config; some toolkits still show the legacy https://backend.composio.dev/api/v1/auth-apps/add."},"wall_probe":{"console_url":"https://app.todoist.com/app/settings/integrations/app-management","final_url":"https://app.todoist.com/app/settings/integrations/app-management","redirect_chain":["https://app.todoist.com/app/settings/integrations/app-management"],"outcome":"console_reachable","wall_host":null,"asks_for":"Page at app.todoist.com loaded but shows no readable content over plain HTTP (a JavaScript app), so a sign-in prompt could not be observed","bot_check":false,"method":"http","observed_at":"2026-10-22"},"conflicts":[],"sources":[{"id":"s1","url":"https://todoist.com/.well-known/oauth-authorization-server","title":"https://todoist.com/.well-known/oauth-authorization-server","accessed":"2026-10-22","kind":"official_docs"},{"id":"s2","url":"https://developer.todoist.com/api/v1/","title":"Todoist API","accessed":"2026-10-22","kind":"official_docs"},{"id":"s3","url":"https://developer.todoist.com/","title":"Todoist Developers — Build with Todoist","accessed":"2026-10-22","kind":"official_docs"},{"id":"s4","url":"https://app.todoist.com/app/settings/integrations/app-management","title":"Developer console sign-in wall probe","accessed":"2026-10-22","kind":"observation"}],"verification_summary":{"total":25,"tested":1,"docs_verified":20,"docs_hidden":0,"community":0,"uncertain":4}}}}

