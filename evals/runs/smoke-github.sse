data: {"type":"data-guide","id":"guide","data":{"slug":"github","permalink":"/guides/github","guide":{"verdict":{"tier":"instant","summary":"Register a GitHub OAuth app, configure Composio's callback URL, and paste the app credentials into Composio. The supplied evidence does not establish a mandatory provider review.","effort_hours":{"min":1.0,"max":3.0},"calendar":{"min_days":0.0,"max_days":0.0,"label":"Same-day setup; no official wait stated"},"calendar_basis":"estimate","confidence":"medium"},"situations":{"questions":[{"id":"connectors","text":"Who will connect GitHub accounts?","options":[{"id":"own_org","label":"Only my organization"},{"id":"customers","label":"Outside users or customer organizations"},{"id":"mixed","label":"Both"}]},{"id":"actions","text":"What must the agent do?","options":[{"id":"read","label":"Read GitHub data"},{"id":"write","label":"Modify repository or issue data"},{"id":"send","label":"Send messages or perform transactional actions"}]}],"variants":[{"when":{"connectors":"own_org","actions":"read"},"tier":"instant","summary":"Register the OAuth app, add the minimum read scopes, and connect the organization's authorized account.","calendar_label":"Same-day setup","notes":[]},{"when":{"connectors":"own_org","actions":"write"},"tier":"instant","summary":"Register the OAuth app, add write scopes, and connect the organization's authorized account.","calendar_label":"Same-day setup","notes":[]},{"when":{"connectors":"customers","actions":"read"},"tier":"instant","summary":"Each external user authorizes the registered app; no separate provider review is established by the evidence.","calendar_label":"Same-day setup plus user authorization","notes":[]},{"when":{"connectors":"mixed","actions":"write"},"tier":"instant","summary":"Register the app, request the required write scopes, and have each intended user or organization authorize it.","calendar_label":"Same-day setup plus user authorization","notes":[]}]},"byo_advice":"Composio's managed app is enough when its shared authorization and permissions meet your needs. Bring your own app when you need separate ownership, credentials, permissions, installation controls, or an independently managed OAuth registration.","before_you_start":[{"text":"The developer console needs a signed-in account: Sign-in page at github.com.","evidence":{"label":"TESTED","source_id":"s6","quote":null,"found_in":null,"note":"Our read-only probe on 2026-10-22 loaded https://github.com/settings/applications/new and ended at https://github.com/login?return_to=https%3A%2F%2Fgithub.com%2Fsettings%2Fapplications%2Fnew (login wall)."}},{"text":"A GitHub app must be registered before its functionality is built.","evidence":{"label":"DOCS","source_id":"s5","quote":"In order to build a GitHub App, you first need to register a GitHub App.","found_in":"visible","note":null}},{"text":"The OAuth app can be created under a personal account or an organization where you have administrative access.","evidence":{"label":"DOCS","source_id":"s2","quote":"You can create and register an OAuth app under your personal account or under any organization you have administrative access to.","found_in":"visible","note":null}},{"text":"The provider registration page requires sign-in.","evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The supplied sign-in-wall observation shows the registration URL redirects to GitHub login."}}],"limits":[{"what":"Issued OAuth tokens per user, application, and scope combination","value":10.0,"unit":"tokens","scope":"per user/application/scope combination","evidence":{"label":"DOCS","source_id":"s4","quote":"There is a limit of ten tokens that are issued per user/application/scope combination","found_in":"visible","note":null}},{"what":"OAuth token creation rate limit","value":10.0,"unit":"tokens per hour","scope":"OAuth app token creation","evidence":{"label":"DOCS","source_id":"s4","quote":"and a rate limit of ten tokens created per hour.","found_in":"visible","note":null}},{"what":"OAuth access-token lifetime when expiring tokens are enabled","value":8.0,"unit":"hours","scope":"OAuth app access tokens","evidence":{"label":"DOCS","source_id":"s1","quote":"The access token expires after eight hours","found_in":"visible","note":null}},{"what":"OAuth apps owned per user or organization","value":100.0,"unit":"OAuth apps","scope":"per user or organization","evidence":{"label":"DOCS","source_id":"s2","quote":"A user or organization can own up to 100 OAuth apps.","found_in":"visible","note":null}},{"what":"Source-code access cannot be scoped read-only","value":null,"unit":"not applicable","scope":"OAuth permissions","evidence":{"label":"DOCS","source_id":"s4","quote":"Currently, you can't scope source code access to read-only.","found_in":"visible","note":null}}],"steps":[{"n":1,"title":"Sign in to GitHub","detail":"Open GitHub's OAuth-app registration page and sign in with the personal or organization account that will own the app.","actor":"human","human_reason":"credential","irreversible":false,"values":[{"label":"Registration URL","value":"https://github.com/settings/applications/new"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The sign-in-wall observation shows this URL redirects to GitHub login. The supplied registration claim starts at the profile menu."}},{"n":2,"title":"Open developer settings and create an OAuth app","detail":"Open the profile menu, choose Settings, open Developer settings, select OAuth apps, and select New OAuth App.","actor":"human","human_reason":"credential","irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s2","quote":"In the upper-right corner of any page on GitHub, click your profile picture, then click Settings.","found_in":"visible","note":null}},{"n":3,"title":"Complete the app registration","detail":"Enter the app name and website. Add a user-facing description if desired, then register the app.","actor":"human","human_reason":"submit","irreversible":false,"values":[{"label":"Application name","value":"Your AI agent app name"},{"label":"Homepage URL","value":"https://your-company.example"}],"evidence":{"label":"DOCS","source_id":"s2","quote":"In \"Application name\", type the name of your app.","found_in":"visible","note":null}},{"n":4,"title":"Set Composio's authorization callback","detail":"Enter Composio's callback URL in the Authorization callback URL field. This must be the exact HTTPS URL shown below.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Authorization callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s2","quote":"In \"Authorization callback URL\", type the callback URL of your app.","found_in":"visible","note":null}},{"n":5,"title":"Select least-privilege scopes","detail":"Request only the scopes required for the agent's read, write, or transactional actions. Document why each scope is needed and review sensitive access before publishing the app.","actor":"either","human_reason":null,"irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s4","quote":"Scopes are named groups of permissions that an OAuth app can request to access both public and non-public data.","found_in":"visible","note":null}},{"n":6,"title":"Copy credentials into Composio","detail":"After registration, obtain the app's client ID and client secret and paste them into the Composio GitHub auth configuration. Rotate the secret if it is exposed.","actor":"human","human_reason":"credential","irreversible":false,"values":[{"label":"GitHub client ID","value":"Paste the client ID generated by GitHub"},{"label":"GitHub client secret","value":"Paste the client secret generated by GitHub"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The supplied claims establish that app registration credentials are used for authenticated API requests, but do not quote the exact GitHub UI or Composio field names for the client ID and secret."}},{"n":7,"title":"Authorize and verify the connection","detail":"Start a Composio connection, sign in as the intended user, authorize the app, and verify only the required operations. A user must authorize the app before it can act for that user.","actor":"human","human_reason":"real_account","irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s5","quote":"With this pattern, the user must authorize the app before the app can take action.","found_in":"visible","note":null}}],"review":{"required":"conditional","trigger":"Each external user or organization must authorize the OAuth app before it can act on that user's behalf; the supplied evidence does not establish a separate provider app-review gate.","submit":["Present the requested scopes and app information during user authorization","Have an organization owner approve administrative organization access when required"],"reviewer":"The authorizing GitHub user or organization owner","wait_official":null,"wait_community":null,"cost":null,"evidence":[{"label":"DOCS","source_id":"s5","quote":"With this pattern, the user must authorize the app before the app can take action.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s4","quote":"if the user of the application is not an organization owner, the application will not be granted administrative access to the organization.","found_in":"visible","note":null}]},"customer_gates":[{"text":"A user must authorize the app before it can act on the user's behalf.","evidence":{"label":"DOCS","source_id":"s5","quote":"With this pattern, the user must authorize the app before the app can take action.","found_in":"visible","note":null}},{"text":"A user must verify their email address before authorizing an OAuth app.","evidence":{"label":"DOCS","source_id":"s4","quote":"You must verify your email address before you can authorize an OAuth app.","found_in":"visible","note":null}},{"text":"Administrative organization access is unavailable when the authorizing user is not an organization owner.","evidence":{"label":"DOCS","source_id":"s4","quote":"if the user of the application is not an organization owner, the application will not be granted administrative access to the organization.","found_in":"visible","note":null}}],"gotchas":[{"text":"Source-code access cannot currently be restricted to read-only by scope.","evidence":{"label":"DOCS","source_id":"s4","quote":"Currently, you can't scope source code access to read-only.","found_in":"visible","note":null}},{"text":"Creating more than ten tokens for the same user and scopes causes GitHub to revoke an existing matching token.","evidence":{"label":"DOCS","source_id":"s4","quote":"If an application creates more than ten tokens for the same user and the same scopes, GitHub revokes one of the existing tokens with the same user/application/scope combination","found_in":"visible","note":null}},{"text":"Hitting the hourly token-creation limit causes a browser re-authorization prompt; it does not revoke the oldest token.","evidence":{"label":"DOCS","source_id":"s4","quote":"Hitting the hourly rate limit will not revoke your oldest token. Instead, it will trigger a re-authorization prompt within the browser","found_in":"visible","note":null}},{"text":"Requesting the offline_access scope opts an individual sign-in into an expiring access token and refresh token.","evidence":{"label":"DOCS","source_id":"s1","quote":"you can opt in to receive an expiring token and a refresh token for an individual sign-in by requesting the offline_access scope","found_in":"visible","note":null}},{"text":"The offline_access scope may have no effect on GitHub Enterprise Server.","evidence":{"label":"DOCS","source_id":"s1","quote":"you should be prepared for the offline_access scope to have no effect","found_in":"visible","note":null}},{"text":"When OAuth apps request new access permissions, GitHub notifies the user about the difference from current permissions.","evidence":{"label":"DOCS","source_id":"s4","quote":"When OAuth apps request new access permissions, they will notify you of the differences between their current permissions and the new permissions.","found_in":"visible","note":null}}],"blockers":[{"symptom":"The connection cannot be completed from the registration URL.","cause":"GitHub requires the user to sign in before creating the OAuth app.","fix":"Sign in to GitHub, then reopen https://github.com/settings/applications/new.","evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Based on the supplied sign-in-wall observation."}},{"symptom":"The app requests administrative organization access but receives none.","cause":"The authorizing user is not an organization owner.","fix":"Have an organization owner authorize the app or reduce the requested permissions.","evidence":{"label":"DOCS","source_id":"s4","quote":"if the user of the application is not an organization owner, the application will not be granted administrative access to the organization.","found_in":"visible","note":null}},{"symptom":"SAML-authorized access fails after the app was installed or changed.","cause":"The browser may not have an active organization SAML session.","fix":"Revoke the app, visit the organization to establish an active SAML session, and reauthorize the app.","evidence":{"label":"DOCS","source_id":"s4","quote":"you may need to revoke the app from your Authorized GitHub Apps or Authorized OAuth apps page, visit the organization to authenticate and establish an active SAML session, and then attempt to reauthorize the app","found_in":"visible","note":null}}],"prepared":{"scopes":[{"scope":"Exact GitHub scope for the required repository, issue, or other resource access","why":"The evidence does not identify the minimum scope for the intended operation, so it must be selected from the final action list.","review_class":"unknown"}],"privacy_policy_outline":["State which GitHub account and organization data the agent reads or modifies.","Explain token storage, retention, deletion, and the OAuth redirect through Composio.","Describe whether a human can revoke access and how revocation affects stored data."],"consent_screen":{"app_name":"Your AI agent app name","app_description":"Explain the agent's purpose and that access is granted through GitHub OAuth.","requested_permissions":"List each scope, the resources it covers, and whether access is read-only or write-capable.","organization_notice":"Explain that an organization owner may be required for administrative organization access.","revocation_instructions":"Explain how users can revoke the app from their authorized GitHub applications."},"review_text":null},"open_questions":["Which exact GitHub scopes are required for the intended read, write, or send actions?","Does the target GitHub deployment require a GitHub App rather than an OAuth app for installation-level or repository-scoped access?","Does GitHub impose an app review for this use case, especially for outside users, sensitive scopes, or marketplace distribution?","What are the exact client ID, client secret, and Composio auth-field names shown after registration?","Should expiring tokens and refresh tokens be enabled, and is the target deployment GitHub Enterprise Server?"],"schema_version":"1","slug":"github","app_name":"GitHub","guide_type":"generated","last_verified":"2026-10-22","composio":{"toolkit_slug":"github","status":"managed","callback_url":"https://backend.composio.dev/api/v3/toolkits/auth/callback","callback_note":"Copy the exact redirect URI shown in your Composio auth config; some toolkits still show the legacy https://backend.composio.dev/api/v1/auth-apps/add."},"wall_probe":{"console_url":"https://github.com/settings/applications/new","final_url":"https://github.com/login?return_to=https%3A%2F%2Fgithub.com%2Fsettings%2Fapplications%2Fnew","redirect_chain":["https://github.com/settings/applications/new","https://github.com/login?return_to=https%3A%2F%2Fgithub.com%2Fsettings%2Fapplications%2Fnew"],"outcome":"login_wall","wall_host":"github.com","asks_for":"Sign-in page at github.com","bot_check":false,"method":"http","observed_at":"2026-10-22"},"conflicts":[],"sources":[{"id":"s1","url":"https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authorizing-oauth-apps","title":"Authorizing OAuth apps - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s2","url":"https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app","title":"Creating an OAuth app - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s4","url":"https://docs.github.com/en/apps/oauth-apps/using-oauth-apps/authorizing-oauth-apps","title":"Authorizing OAuth apps - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s5","url":"https://docs.github.com/en/apps/creating-github-apps/about-creating-github-apps/about-creating-github-apps","title":"About creating GitHub Apps - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s6","url":"https://github.com/settings/applications/new","title":"Developer console sign-in wall probe","accessed":"2026-10-22","kind":"observation"}],"verification_summary":{"total":30,"tested":1,"docs_verified":25,"docs_hidden":0,"community":0,"uncertain":4}}}}

