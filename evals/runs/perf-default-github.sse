data: {"type":"data-guide","id":"guide","data":{"slug":"github","permalink":"/guides/github","guide":{"verdict":{"tier":"instant","summary":"GitHub permits self-serve OAuth app registration for personal use or other users, with no provider app-review requirement stated (s4: \"You can build OAuth apps for yourself or others to use.\").","effort_hours":{"min":0.5,"max":2.0},"calendar":{"min_days":0.0,"max_days":null,"label":"Registration is immediate; no review wait is stated"},"calendar_basis":"estimate","confidence":"high"},"situations":{"questions":[{"id":"audience","text":"Who will connect to the app?","options":[{"id":"own_org","label":"Your own organization only"},{"id":"outside_users","label":"Outside users or customers"}]},{"id":"actions","text":"What must the agent do?","options":[{"id":"read","label":"Read data"},{"id":"write","label":"Create or modify data"},{"id":"write_send","label":"Write data and send messages or notifications"}]}],"variants":[{"when":{"audience":"own_org","actions":"read"},"tier":"instant","summary":"Register an OAuth app for personal use or under an organization where you have administrative access (s4).","calendar_label":"Immediate registration; no review wait stated","notes":["Create the app from Settings → Developer settings → OAuth apps → New OAuth App (s3)."]},{"when":{"audience":"own_org","actions":"write"},"tier":"instant","summary":"Register the app and request only the scopes needed for write operations; OAuth tokens cannot exceed the user's existing permissions (s4).","calendar_label":"Immediate registration; no review wait stated","notes":["Check the scopes actually granted before making API requests (s1)."]},{"when":{"audience":"outside_users","actions":"read"},"tier":"instant","summary":"Register an OAuth app for other users and configure Composio's authorization callback URL.","calendar_label":"Immediate registration; no provider review wait stated","notes":["The authorization callback URL is required, and GitHub redirects successful authentications to it (s1)."]},{"when":{"audience":"outside_users","actions":"write"},"tier":"instant","summary":"Register an OAuth app for outside users, request minimum necessary scopes, and rely on each user's authorization and permission approvals.","calendar_label":"Immediate registration; no provider review wait stated","notes":["For GitHub Apps, users must approve added repository or organization permissions before the installation receives them (s2)."]}]},"byo_advice":"Composio's managed GitHub app is enough for a quick proof of concept. Bring your own OAuth app when you need your own client registration, controlled scopes, or an independently managed GitHub identity: sign in to GitHub, open Settings → Developer settings → OAuth apps → New OAuth App, enter the app name, homepage, required scopes, and Composio's callback URL, then create the app and paste its client ID and client secret into the Composio auth config (s3: \"In \\\"Application name\\\", type the name of your app.\"; s3: \"In \\\"Homepage URL\\\", type the full URL to your app's website.\"; s3: \"In \\\"Authorization callback URL\\\", type the callback URL of your app.\"). Keep web-app secrets out of client code (s1: \"You must\\ninclude the client secret in your native application, however web applications should not leak this value.\"); request only scopes needed and check the scopes actually granted (s2: \"When you register a GitHub App, select the minimum permissions that your GitHub App needs.\"; s1: \"Before making any requests with the token, check the scopes that were granted for the token by the user.\").","before_you_start":[{"text":"The developer console needs a signed-in account: Sign-in page at github.com.","evidence":{"label":"TESTED","source_id":"s6","quote":null,"found_in":null,"note":"Our read-only probe on 2026-10-22 loaded https://github.com/settings/applications/new and ended at https://github.com/login?return_to=https%3A%2F%2Fgithub.com%2Fsettings%2Fapplications%2Fnew (login wall)."}},{"text":"You need a GitHub account and administrative access to register the app under an organization.","evidence":{"label":"DOCS","source_id":"s4","quote":"You can create and register an OAuth app under your personal account or under any organization you have administrative access to.","found_in":"visible","note":null}},{"text":"A user or organization can own up to 100 OAuth apps.","evidence":{"label":"DOCS","source_id":"s3","quote":"A user or organization can own up to 100 OAuth apps.","found_in":"visible","note":null}},{"text":"An OAuth app can have up to 10 callback URLs.","evidence":{"label":"DOCS","source_id":"s3","quote":"You can enter up to 10 callback URLs.","found_in":"visible","note":null}},{"text":"Decide which concrete GitHub API operations the agent must perform so its scopes can be minimized.","evidence":{"label":"DOCS","source_id":"s4","quote":"Scopes limit access for OAuth tokens. They do not grant any additional permission beyond that which the user already has.","found_in":"visible","note":null}}],"limits":[{"what":"OAuth apps owned","value":100.0,"unit":"OAuth apps","scope":"per user or organization","evidence":{"label":"DOCS","source_id":"s3","quote":"A user or organization can own up to 100 OAuth apps.","found_in":"visible","note":null}},{"what":"OAuth app callback URLs","value":10.0,"unit":"callback URLs","scope":"per OAuth app","evidence":{"label":"DOCS","source_id":"s3","quote":"You can enter up to 10 callback URLs.","found_in":"visible","note":null}},{"what":"GitHub App callback URLs","value":10.0,"unit":"callback URLs","scope":"per GitHub App","evidence":{"label":"DOCS","source_id":"s5","quote":"You can specify up to 10 callback URLs.","found_in":"visible","note":null}},{"what":"Installation access token lifetime","value":1.0,"unit":"hour","scope":"installation access token","evidence":{"label":"DOCS","source_id":"s2","quote":"Installation access tokens expire after one hour, expiring user access tokens expire after eight hours, and refresh tokens expire after six months.","found_in":"visible","note":null}},{"what":"Expiring user access token lifetime","value":8.0,"unit":"hours","scope":"expiring user access token","evidence":{"label":"DOCS","source_id":"s2","quote":"Installation access tokens expire after one hour, expiring user access tokens expire after eight hours, and refresh tokens expire after six months.","found_in":"visible","note":null}},{"what":"Refresh token lifetime","value":6.0,"unit":"months","scope":"refresh token","evidence":{"label":"DOCS","source_id":"s2","quote":"Installation access tokens expire after one hour, expiring user access tokens expire after eight hours, and refresh tokens expire after six months.","found_in":"visible","note":null}}],"steps":[{"n":1,"title":"Sign in to GitHub","detail":"Open the GitHub OAuth app registration page and sign in to the account that will own the app.","actor":"human","human_reason":"identity","irreversible":false,"values":[],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"The observed registration URL redirects unauthenticated visitors to GitHub's sign-in page."}},{"n":2,"title":"Choose the app owner","detail":"Register under your personal account or an organization for which you have administrative access.","actor":"human","human_reason":"identity","irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s4","quote":"You can create and register an OAuth app under your personal account or under any organization you have administrative access to.","found_in":"visible","note":null}},{"n":3,"title":"Create the OAuth app","detail":"In the profile menu, open Settings, then Developer settings, select OAuth apps, and click New OAuth App or Register a new application.","actor":"human","human_reason":"submit","irreversible":true,"values":[{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s3","quote":"In the upper-right corner of any page on GitHub, click your profile picture, then click Settings.","found_in":"visible","note":null}},{"n":4,"title":"Enter the application fields","detail":"Provide the application name, homepage URL, and Composio authorization callback URL. The callback URL is the only paste value included here.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Authorization callback URL","value":"https://backend.composio.dev/api/v3/toolkit/auth/callback"},{"label":"Composio callback URL","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s3","quote":"In \"Authorization callback URL\", type the callback URL of your app.","found_in":"visible","note":null}},{"n":5,"title":"Choose scopes and submit","detail":"Request only the scopes required by the agent's GitHub operations, submit the registration, and complete any provider review required before use.","actor":"human","human_reason":"submit","irreversible":true,"values":[],"evidence":{"label":"DOCS","source_id":"s4","quote":"Scopes limit access for OAuth tokens. They do not grant any additional permission beyond that which the user already has.","found_in":"visible","note":"The supplied claims do not verify whether this OAuth app receives a separate provider review."}},{"n":6,"title":"Add the credentials to Composio","detail":"After the app is usable, copy its generated client ID and client secret into the corresponding fields of the Composio GitHub auth configuration.","actor":"human","human_reason":"credential","irreversible":false,"values":[],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"Check the current Composio GitHub auth-configuration screen for the exact credential field names and placement."}},{"n":7,"title":"Verify authorization","detail":"Run a test connection and check the scopes actually granted before making API requests.","actor":"either","human_reason":null,"irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s1","quote":"Before making any requests with the token, check the scopes that were granted for the token by the user.","found_in":"visible","note":null}}],"review":{"required":"no","trigger":null,"submit":[],"reviewer":null,"wait_official":null,"wait_community":null,"cost":null,"evidence":[{"label":"DOCS","source_id":"s4","quote":"You can build OAuth apps for yourself or others to use.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s3","quote":"In the upper-right corner of any page on GitHub, click your profile picture, then click Settings.","found_in":"visible","note":null}]},"customer_gates":[{"text":"Registering under an organization requires administrative access to that organization.","evidence":{"label":"DOCS","source_id":"s4","quote":"You can create and register an OAuth app under your personal account or under any organization you have administrative access to.","found_in":"visible","note":null}},{"text":"A user's consent cannot grant access beyond the permissions that user already has.","evidence":{"label":"DOCS","source_id":"s4","quote":"Scopes limit access for OAuth tokens. They do not grant any additional permission beyond that which the user already has.","found_in":"visible","note":null}},{"text":"Check whether the target organization imposes additional OAuth-app, credential, or network restrictions.","evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":null,"note":"No organization-policy details were supplied; confirm them with the organization administrator."}}],"gotchas":[{"text":"Expiring user access tokens expire after eight hours, while refresh tokens expire after six months.","evidence":{"label":"DOCS","source_id":"s2","quote":"Installation access tokens expire after one hour, expiring user access tokens expire after eight hours, and refresh tokens expire after six months.","found_in":"visible","note":null}},{"text":"Expiring user access tokens are enabled by default for OAuth apps.","evidence":{"label":"DOCS","source_id":"s3","quote":"Expire user access tokens is enabled by default. If your app's authentication code hasn't been updated to support short-lived tokens, uncheck the box until support is added.","found_in":"visible","note":null}},{"text":"Requesting offline_access during sign-in provides an expiring user access token and a refresh token.","evidence":{"label":"DOCS","source_id":"s2","quote":"To test and gradually roll out support for expiring tokens, request the offline_access scope when you sign in a user.","found_in":"visible","note":null}},{"text":"A missing callback route can produce a 404 after authorization.","evidence":{"label":"DOCS","source_id":"s1","quote":"We didn't provide\na route for it, so GitHub doesn't know where to drop the user after they authorize\nthe app.","found_in":"visible","note":null}},{"text":"Wildcard callback matching can allow authorization codes to be sent to unintended subdomains or subdirectories.","evidence":{"label":"DOCS","source_id":"s2","quote":"Enabling wildcard matching can expose your app to security risks, because it allows an attacker to send authorization codes to any subdomain or subdirectory of the callback URL.","found_in":"visible","note":null}},{"text":"Users may grant different scopes from those requested, so the granted scopes must be checked before API requests.","evidence":{"label":"DOCS","source_id":"s1","quote":"Before making any requests with the token, check the scopes that were granted for the token by the user.","found_in":"visible","note":null}}],"blockers":[{"symptom":"Authorization finishes with a 404.","cause":"The app did not provide a callback route for GitHub's redirect.","fix":"Register https://backend.composio.dev/api/v3/toolkit/auth/callback exactly as the Authorization callback URL.","evidence":{"label":"DOCS","source_id":"s1","quote":"We didn't provide\na route for it, so GitHub doesn't know where to drop the user after they authorize\nthe app.","found_in":"visible","note":null}},{"symptom":"Authorization codes may be sent to an unintended subdomain or subdirectory.","cause":"Wildcard callback matching is enabled.","fix":"Avoid wildcard matching and configure the exact Composio callback URL.","evidence":{"label":"DOCS","source_id":"s2","quote":"Enabling wildcard matching can expose your app to security risks, because it allows an attacker to send authorization codes to any subdomain or subdirectory of the callback URL.","found_in":"visible","note":null}}],"prepared":{"scopes":[{"scope":"Minimum scopes required by the agent's specific GitHub API operations","why":"OAuth scopes limit token access and do not exceed the user's existing permissions.","review_class":"unknown"}],"privacy_policy_outline":["State that the app connects the user's authorized GitHub account to the developer and its AI agent through Composio.","List the GitHub data accessed, the operations performed, and how credentials and tokens are protected.","Describe user authorization, revocation, and any token refresh or expiration handling."],"consent_screen":{"app_name":"The registered GitHub OAuth app name","requested_scopes":"The minimum GitHub scopes required by the agent","purpose":"Explain why the agent needs GitHub access","authorization_action":"Authorize or cancel","permissions_notice":"Clarify that access cannot exceed the user's existing permissions"},"review_text":"This app connects the developer's AI agent to GitHub through Composio. It requests only the minimum scopes needed for the identified GitHub operations, requires user authorization, and limits token access to permissions the user already has."},"open_questions":["Which GitHub API operations and exact scopes does the agent require?","Does GitHub require a separate review for this OAuth app and what are its submission and approval requirements?","Does the current Composio GitHub auth configuration require any additional OAuth settings beyond the client ID, client secret, scopes, and callback URL?","Should the integration request offline_access and use refresh tokens for long-running sessions?","Are there target-organization policies that restrict OAuth app creation or access?"],"schema_version":"1","slug":"github","app_name":"GitHub","guide_type":"generated","last_verified":"2026-10-22","composio":{"toolkit_slug":"github","status":"managed","callback_url":"https://backend.composio.dev/api/v3/toolkits/auth/callback","callback_note":"Copy the exact redirect URI shown in your Composio auth config; some toolkits still show the legacy https://backend.composio.dev/api/v1/auth-apps/add."},"wall_probe":{"console_url":"https://github.com/settings/applications/new","final_url":"https://github.com/login?return_to=https%3A%2F%2Fgithub.com%2Fsettings%2Fapplications%2Fnew","redirect_chain":["https://github.com/settings/applications/new","https://github.com/login?return_to=https%3A%2F%2Fgithub.com%2Fsettings%2Fapplications%2Fnew"],"outcome":"login_wall","wall_host":"github.com","asks_for":"Sign-in page at github.com","bot_check":false,"method":"http","observed_at":"2026-10-22"},"conflicts":[],"sources":[{"id":"s1","url":"https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authenticating-to-the-rest-api-with-an-oauth-app","title":"Authenticating to the REST API with an OAuth app - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s2","url":"https://docs.github.com/en/apps/creating-github-apps/about-creating-github-apps/best-practices-for-creating-a-github-app","title":"Best practices for creating a GitHub App - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s3","url":"https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app","title":"Creating an OAuth app - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s4","url":"https://docs.github.com/en/apps/oauth-apps/building-oauth-apps","title":"Building OAuth apps - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s5","url":"https://docs.github.com/en/apps/creating-github-apps/registering-a-github-app/about-the-user-authorization-callback-url","title":"About the user authorization callback URL - GitHub Docs","accessed":"2026-10-22","kind":"official_docs"},{"id":"s6","url":"https://github.com/settings/applications/new","title":"Developer console sign-in wall probe","accessed":"2026-10-22","kind":"observation"}],"verification_summary":{"total":31,"tested":1,"docs_verified":27,"docs_hidden":0,"community":0,"uncertain":3}}}}

