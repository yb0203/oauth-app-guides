data: {"type":"data-guide","id":"guide","data":{"slug":"spotify","permalink":"/guides/spotify","guide":{"verdict":{"tier":"partner_only","summary":"Spotify Development Mode apps support up to 5 allowlisted users. Scaling for outside users requires an organization-only quota extension and Spotify app review, which can take up to six weeks.","effort_hours":{"min":3.0,"max":8.0},"calendar":{"min_days":0.0,"max_days":42.0,"label":"Up to 6 weeks for quota-extension and app review"},"calendar_basis":"official","confidence":"medium"},"situations":{"questions":[{"id":"connectors","text":"Who will connect through the developer’s Spotify app?","options":[{"id":"own_org","label":"Users in my own organization"},{"id":"outside_users","label":"Outside or public users"}]},{"id":"actions","text":"What must the agent do after connecting?","options":[{"id":"read","label":"Read Spotify data"},{"id":"write_send","label":"Write data or send actions"}]}],"variants":[{"when":{"connectors":"own_org","actions":"read"},"tier":"verify_to_scale","summary":"A Development Mode app can support a small internal audience, but it is limited to 5 authenticated users and allowlisting.","calendar_label":"Available for initial users; extension review can take up to 6 weeks","notes":[]},{"when":{"connectors":"own_org","actions":"write_send"},"tier":"verify_to_scale","summary":"The same Development Mode user and allowlist constraints apply; the claims do not establish different rules for read versus write actions.","calendar_label":"Available for initial users; extension review can take up to 6 weeks","notes":[]},{"when":{"connectors":"outside_users","actions":"read"},"tier":"partner_only","summary":"Outside-user scaling requires the organization-only quota-extension and approval path.","calendar_label":"Official review turnaround: up to 6 weeks","notes":[]},{"when":{"connectors":"outside_users","actions":"write_send"},"tier":"partner_only","summary":"Outside-user scaling remains subject to organization eligibility and Spotify review, with no separate read-versus-write rule documented.","calendar_label":"Official review turnaround: up to 6 weeks","notes":[]}]},"byo_advice":"Bring your own Spotify app for this setup: register it, configure Composio’s callback URI and scopes, then use its client credentials in the Composio auth config. Composio’s managed app may be sufficient for a small internal connection within Spotify’s 5-user Development Mode cap, but not for an organization-only quota-extension path.","before_you_start":[{"text":"The developer console needs a signed-in account: Page at developer.spotify.com loaded but shows no readable content over plain HTTP (a JavaScript app), so a sign-in prompt could not be observed.","evidence":{"label":"TESTED","source_id":"s6","quote":null,"found_in":null,"note":"Our read-only probe on 2026-10-22 loaded https://developer.spotify.com/dashboard and ended at https://developer.spotify.com/dashboard (console reachable)."}},{"text":"A development-mode app owner must have a Spotify Premium account for the app to function.","evidence":{"label":"DOCS","source_id":"s5","quote":"The app owner must have a Spotify Premium account for apps\nin development mode to function.","found_in":"visible","note":null}},{"text":"Development-mode apps can be used by up to 5 authenticated Spotify users, who must also be allowlisted.","evidence":{"label":"DOCS","source_id":"s5","quote":"Up to 5 authenticated Spotify users can use an app that is in development mode","found_in":"visible","note":null}},{"text":"All Development Mode Client IDs for one developer account share one API quota budget.","evidence":{"label":"DOCS","source_id":"s2","quote":"Quota counting is now per developer account, not per Client ID. All\nyour Development Mode Client IDs share a single quota.","found_in":"visible","note":null}},{"text":"A developer account can create up to 25 Client IDs.","evidence":{"label":"DOCS","source_id":"s2","quote":"You can now create up to 25 Client IDs per developer account to better\nhelp you organize your projects the way you want.","found_in":"visible","note":null}},{"text":"Confirm whether your use case needs a quota extension before submitting the application; extension review can take up to six weeks.","evidence":{"label":"DOCS","source_id":"s5","quote":"This review process can take\nup to six weeks.","found_in":"visible","note":null}},{"text":"Verify the current dashboard requirements for client-secret issuance and the exact review submission route; these details are not established by the supplied claims.","evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":"visible","note":"Check the signed-in Spotify developer console and current OAuth documentation."}}],"limits":[{"what":"Client IDs","value":25.0,"unit":"Client IDs","scope":"per developer account","evidence":{"label":"DOCS","source_id":"s2","quote":"You can now create up to 25 Client IDs per developer account to better\nhelp you organize your projects the way you want.","found_in":"visible","note":null}},{"what":"Monthly active users required for quota extension","value":250000.0,"unit":"monthly active users","scope":"quota extension applicants","evidence":{"label":"DOCS","source_id":"s5","quote":"Maintaining a minimum of active users (at least 250k MAUs)","found_in":"visible","note":null}},{"what":"Authenticated users allowed to use a Development Mode app","value":5.0,"unit":"authenticated users","scope":"development mode apps","evidence":{"label":"DOCS","source_id":"s5","quote":"Up to 5 authenticated Spotify users can use an app that is in development mode","found_in":"visible","note":null}},{"what":"Quota-exceeded response","value":429.0,"unit":"HTTP status code","scope":"development mode quota exceeded response","evidence":{"label":"DOCS","source_id":"s2","quote":"When your quota is exceeded, the 429 Too Many Requests response now returns\na structured JSON body with a \"reason\": \"QUOTA_EXCEEDED\" field.","found_in":"visible","note":null}},{"what":"Response used to distinguish quota limits from rate limits","value":429.0,"unit":"HTTP status code","scope":"application error handling for quota and rate limits","evidence":{"label":"DOCS","source_id":"s2","quote":"Handle the new 429 body. Use the reason field to distinguish\nquota limits from rate limits and pace your usage accordingly.","found_in":"visible","note":null}},{"what":"Response for a non-allowlisted Development Mode user","value":403.0,"unit":"HTTP status code","scope":"development mode API requests for non-allowlisted users","evidence":{"label":"DOCS","source_id":"s5","quote":"However, API requests with an access token\nassociated to that user and app will receive a 403 status code error.","found_in":"visible","note":null}}],"steps":[{"n":1,"title":"Sign in to Spotify's developer console","detail":"Open the Spotify developer dashboard and sign in with the developer or organization account that will own the app.","actor":"human","human_reason":"credential","irreversible":false,"values":[{"label":"Developer console","value":"https://developer.spotify.com/dashboard"}],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":"visible","note":"The dashboard URL was reachable, but its JavaScript-rendered sign-in prompt could not be read over plain HTTP."}},{"n":2,"title":"Register your own application","detail":"Create an application in the correct Spotify development mode. Record the client ID Spotify provides; verify whether the developer console also exposes a client secret for the Composio configuration.","actor":"human","human_reason":"credential","irreversible":false,"values":[],"evidence":{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":"visible","note":"The claims confirm that an application must be created and that Spotify provides a client ID, but do not document the current dashboard fields or client-secret issuance."}},{"n":3,"title":"Configure the OAuth redirect URI","detail":"Add Composio's callback URL to the app's registered redirect URI allowlist. Preserve it exactly, including letter case and any trailing-slash differences.","actor":"agent","human_reason":null,"irreversible":false,"values":[{"label":"Redirect URI","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"DOCS","source_id":"s4","quote":"The value of redirect_uri here must exactly match one of the values you entered when you registered your application, including upper or lowercase, terminating slashes, and such.","found_in":"visible","note":null}},{"n":4,"title":"Choose the minimum required scopes","detail":"Select only the Spotify scopes needed by the agent's intended features. Confirm the current scope names and classifications in Spotify's documentation because the supplied claims do not identify a universal minimum scope set.","actor":"either","human_reason":null,"irreversible":true,"values":[],"evidence":{"label":"DOCS","source_id":"s4","quote":"A space-separated list of scopes.","found_in":"visible","note":null}},{"n":5,"title":"Prepare and submit the app for review","detail":"Provide the app information, images, APIs or SDKs, and Terms of Service requested by Spotify, then submit the application for review. A human may need to accept terms, make corrections, and respond to follow-up questions.","actor":"human","human_reason":"submit","irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s1","quote":"This starts with the application information, images, APIs/SDKs used, and extends into things like the Terms of Service.","found_in":"visible","note":null}},{"n":6,"title":"Wait for review and configure Composio","detail":"After approval, create the Spotify authentication configuration in Composio and paste in the own-app client credentials and redirect URI. Keep tracking any review correspondence because Spotify may require multiple exchanges.","actor":"either","human_reason":null,"irreversible":false,"values":[{"label":"Composio redirect URI","value":"https://backend.composio.dev/api/v3/toolkits/auth/callback"}],"evidence":{"label":"UNCERTAIN","source_id":"s3","quote":null,"found_in":null,"note":"Downgraded from DOCS: quote not found on the source page. Original quote: \"Spotify's app review team will take a look at your app and evaluate\nit for compliance with our Developer Policy.\"."}},{"n":7,"title":"Handle quota-extension eligibility","detail":"If the integration requires a quota extension, use the applicable Spotify extension request process and monitor the review. For quota extensions, an organization, company email, active launched service, and at least 250,000 monthly active users are required.","actor":"human","human_reason":"submit","irreversible":false,"values":[],"evidence":{"label":"DOCS","source_id":"s5","quote":"as of May 15th 2025, Spotify only accepts\napplications from organizations (not individuals).","found_in":"visible","note":null}}],"review":{"required":"conditional","trigger":"Request a quota extension for outside-user or larger-scale use; quota-extension applications are accepted only from organizations.","submit":["Open Settings => Extension Request in the correct Development Mode application.","Complete the Quota Form and submit it through a company email.","Provide the application information, images, APIs or SDKs used, and applicable Terms of Service."],"reviewer":"Spotify's app review team","wait_official":"Up to six weeks.","wait_community":null,"cost":null,"evidence":[{"label":"DOCS","source_id":"s1","quote":"head to Settings => Extension Request to bring up the Quota Form and begin the process.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s5","quote":"as of May 15th 2025, Spotify only accepts\napplications from organizations (not individuals).","found_in":"visible","note":null},{"label":"DOCS","source_id":"s5","quote":"Application must be sent through a company email by using this form.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s1","quote":"This starts with the application information, images, APIs/SDKs used, and extends into things like the Terms of Service.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s5","quote":"Spotify's app review team will take a look at your app and evaluate\nit for compliance with our Developer Policy.","found_in":"visible","note":null},{"label":"DOCS","source_id":"s5","quote":"This review process can take\nup to six weeks.","found_in":"visible","note":null},{"label":"UNCERTAIN","source_id":null,"quote":null,"found_in":"visible","note":"The dashboard was reachable, but its JavaScript-rendered content and any sign-in prompt were not readable over plain HTTP; verify the current registration screen and required fields in a browser."}]},"customer_gates":[{"text":"Each Spotify user installing a development-mode app must be added to the app's allowlist before use.","evidence":{"label":"DOCS","source_id":"s5","quote":"Each Spotify user who installs your app\nwill need to be added to your app's allowlist before they can use it.","found_in":"visible","note":null}},{"text":"The logged-in Spotify user is shown the requested scopes and must authorize access to the associated data or features.","evidence":{"label":"DOCS","source_id":"s3","quote":"When the user is logged in, they are asked to\nauthorize access to the data sets or features defined in the scopes.","found_in":"visible","note":null}},{"text":"If no scopes are requested, authorization grants access only to publicly available information.","evidence":{"label":"DOCS","source_id":"s3","quote":"If no scopes are specified, authorization will be granted only to access publicly available information","found_in":"visible","note":null}},{"text":"With show_dialog set to true, the user is not automatically redirected and must approve the app again.","evidence":{"label":"DOCS","source_id":"s3","quote":"If true, the user will not be automatically redirected and will have to approve the app again.","found_in":"visible","note":null}}],"gotchas":[{"text":"The redirect URI must exactly match an allowlisted registered value, including uppercase versus lowercase and trailing slashes.","evidence":{"label":"DOCS","source_id":"s4","quote":"The value of redirect_uri here must exactly match one of the values you entered when you registered your application, including upper or lowercase, terminating slashes, and such.","found_in":"visible","note":null}},{"text":"The authorization-code token exchange must use grant_type authorization_code and include the code and matching redirect URI.","evidence":{"label":"DOCS","source_id":"s3","quote":"grant_type\nRequired\nThis field must contain the value \"authorization_code\".\ncode\nRequired\nThe authorization code returned from the previous request.\nredirect_uri\nRequired","found_in":"visible","note":null}},{"text":"The implicit flow uses short-lived access tokens without refresh tokens and does not use secret keys; this differs from a server-side authorization-code integration.","evidence":{"label":"DOCS","source_id":"s4","quote":"Access tokens issued are short-lived with no refresh token to extend them when\nthey expire.","found_in":"visible","note":null}},{"text":"Handle a 429 response by inspecting its reason field to distinguish quota exhaustion from rate limiting, then pace requests accordingly.","evidence":{"label":"DOCS","source_id":"s2","quote":"Handle the new 429 body. Use the reason field to distinguish\nquota limits from rate limits and pace your usage accordingly.","found_in":"visible","note":null}},{"text":"Do not use the implicit-flow state guidance as a substitute for a server-side state/CSRF design; the state parameter is optional but strongly recommended for request correlation.","evidence":{"label":"DOCS","source_id":"s4","quote":"The state can be useful for correlating requests and responses.","found_in":"visible","note":null}},{"text":"If caching Spotify data, keep it current and comply with Spotify's data-freshness guidelines.","evidence":{"label":"DOCS","source_id":"s1","quote":"However, it is crucial to keep the cached data up to date and respect Spotify's guidelines regarding data freshness.","found_in":"visible","note":null}}],"blockers":[{"symptom":"API calls for a development-mode user return HTTP 403.","cause":"The Spotify user associated with the access token is not on the app's allowlist.","fix":"Add the user to the app allowlist before using their token.","evidence":{"label":"DOCS","source_id":"s5","quote":"However, API requests with an access token\nassociated to that user and app will receive a 403 status code error.","found_in":"visible","note":null}},{"symptom":"The Web API returns HTTP 429 after usage exceeds the applicable quota.","cause":"The app's request usage has exceeded its quota, and the response body identifies QUOTA_EXCEEDED.","fix":"Inspect the response reason, pace usage, and determine whether a quota extension is required.","evidence":{"label":"DOCS","source_id":"s2","quote":"When your quota is exceeded, the 429 Too Many Requests response now returns\na structured JSON body with a \"reason\": \"QUOTA_EXCEEDED\" field.","found_in":"visible","note":null}},{"symptom":"The OAuth redirect is rejected or does not match the registered configuration.","cause":"The supplied redirect URI differs from the allowlisted value in letter case, trailing slash, or another character.","fix":"Use the exact registered redirect URI, including https://backend.composio.dev/api/v3/toolkits/auth/callback.","evidence":{"label":"DOCS","source_id":"s4","quote":"The value of redirect_uri here must exactly match one of the values you entered when you registered your application, including upper or lowercase, terminating slashes, and such.","found_in":"visible","note":null}}],"prepared":{"scopes":[{"scope":"Exact minimum Spotify scope set required by the intended agent features","why":"Authorization without scopes grants only publicly available information; request only the access needed by the integration.","review_class":"unknown"}],"privacy_policy_outline":["State what Spotify data the agent accesses and why.","Describe storage, retention, sharing, and deletion practices.","Provide a contact or support method for privacy requests."],"consent_screen":{"title":"Connect Spotify to the AI agent","description":"Explain which Spotify features and data the agent can access and that the user may deny access.","scopes":"List each requested scope in plain language.","actions":"Identify the application requesting access.","privacy_contact":"Provide the privacy-policy or support contact."},"review_text":"Provide accurate application information, screenshots or images, the APIs and SDKs used, the requested scopes and their purpose, and the Terms of Service requested by Spotify."},"open_questions":["What are the exact Spotify scope names required for the agent's intended features, and how does Spotify classify them for review?","Does the current Spotify developer console issue a client secret for this app, and which Composio credential fields require it?","Which Spotify app mode and quota extension route apply to the intended production use case?","What exact submission, testing, and image requirements does the current developer console enforce?","Does the Composio Spotify auth configuration require an additional field beyond the own-app client ID, client secret, and callback URI?"],"schema_version":"1","slug":"spotify","app_name":"Spotify","guide_type":"generated","last_verified":"2026-10-22","composio":{"toolkit_slug":"spotify","status":"byo","callback_url":"https://backend.composio.dev/api/v3/toolkits/auth/callback","callback_note":"Copy the exact redirect URI shown in your Composio auth config; some toolkits still show the legacy https://backend.composio.dev/api/v1/auth-apps/add."},"wall_probe":{"console_url":"https://developer.spotify.com/dashboard","final_url":"https://developer.spotify.com/dashboard","redirect_chain":["https://developer.spotify.com/dashboard"],"outcome":"console_reachable","wall_host":null,"asks_for":"Page at developer.spotify.com loaded but shows no readable content over plain HTTP (a JavaScript app), so a sign-in prompt could not be observed","bot_check":false,"method":"http","observed_at":"2026-10-22"},"conflicts":[],"sources":[{"id":"s1","url":"https://developer.spotify.com/blog/2023-05-29-quota-extension","title":"Moving Through It: Getting An Application Reviewed | Spotify for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s2","url":"https://developer.spotify.com/blog/2026-07-23-web-api-quota-updates","title":"Web API quota updates for Development Mode | Spotify for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s3","url":"https://developer.spotify.com/documentation/web-api/tutorials/code-flow","title":"Authorization Code Flow | Spotify for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s4","url":"https://developer.spotify.com/documentation/web-api/tutorials/implicit-flow","title":"Implicit Grant Flow | Spotify for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s5","url":"https://developer.spotify.com/documentation/web-api/concepts/quota-modes","title":"Quota modes | Spotify for Developers","accessed":"2026-10-22","kind":"official_docs"},{"id":"s6","url":"https://developer.spotify.com/dashboard","title":"Developer console sign-in wall probe","accessed":"2026-10-22","kind":"observation"}],"verification_summary":{"total":40,"tested":1,"docs_verified":34,"docs_hidden":0,"community":0,"uncertain":5}}}}

